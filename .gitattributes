# Source and documentation use stable line endings across machines.
* text=auto eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Preserve original archive data and extracted JASS bytes exactly.
Analysis/** -text
*.j -text
*.wts -text
*.w3a -text
*.w3b -text
*.w3e -text
*.w3h -text
*.w3i -text
*.w3q -text
*.w3t -text
*.w3u -text

# Large original maps and Unreal assets use Git LFS.
*.w3x filter=lfs diff=lfs merge=lfs -text
*.w3m filter=lfs diff=lfs merge=lfs -text
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
