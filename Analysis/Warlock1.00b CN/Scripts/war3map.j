ction qg takes nothing returns nothinglocal string s=GetEventPlayerChatString()local integer i=0local integer j=0local integer array Qgif zn or SubString(s,0,1)!="-" thenreturnendifset Qg[0]=0loopexitwhen(i>StringLength(s))if SubString(s,i,i+1)=="," thenset j=j+1set Qg[j]=iendifset i=i+1endloopset i=0loopexitwhen i>jif not OE thencall jg("-"+SubString(s,Qg[i]+1,Qg[i+1]))endifset i=i+1endloopendfunctionfunction Pg takes nothing returns nothinglocal string array sglocal integer i=0if GetLocalPlayer()==Player(0)thencall ClearTextMessages()endifif not EE thenloopexitwhen i>$Cset sg[i]=""set i=i+1endloopset i=0loopexitwhen i>$Bif GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING thenset sg[gV[i]]=sg[gV[i]]+" "+FV[i]endifset i=i+1endloopcall ZX(" ",999)call ZX("选择队伍:",999)set i=0loopexitwhen i>$Cif sg[i]!="" thenif i!=$C thencall ZX(yV[i]+"队伍 "+I2S(i+1)+"|r:"+sg[i],999)elsecall ZX("|c00707070观看者|r:"+sg[i],999)endifendifset i=i+1endloopelsecall ZX(" ",999)call ZX("|cff80ff00请等待主机设置游戏模式.|r",999)call ZX(" ",999)call ZX("|cff9e9e9e-tutorial|r |cffcccccc(开启教程手把手教你玩术士)|r",999)call ZX("|cff9e9e9e-cam ###|r |cffcccccc(设置镜头距离)|r",999)call ZX("|cff9e9e9e-autoselect|r |cffcccccc(自动选择你的角色)|r",999)call ZX("|cff9e9e9e-stats|r |cffcccccc(显示你角色的各项数值)|r",999)call ZX("|cff9e9e9e-apm|r |cffcccccc(显示所有玩家的APM)|r",999)call ZX("|cff9e9e9e-fbc ### ### ###|r |cffcccccc(改变火球颜色)|r",999)call ZX(" ",999)if GetLocalPlayer()==Player(0)thencall ClearTextMessages()endifendifcall DisplayTimedTextToPlayer(Player(0),0,0,999," ")call DisplayTimedTextToPlayer(Player(0),0,0,999,"选择设置:")if xV==1 or xV==3 or xV==4 thencall DisplayTimedTextToPlayer(Player(0),0,0,999,"|c0080FF00-|r|c00E8E800[回合数]|r 按照当前的设置开始")elseif xV==2 or xV==5 thencall DisplayTimedTextToPlayer(Player(0),0,0,999,"|c0080FF00-|r|c00E8E800[积分上限]|r 按照当前设置开始")call DisplayTimedTextToPlayer(Player(0),0,0,999,"|c0080FF00-|r|c00E8E800[时间上限]|r|c0080FF00m|r 开始限时赛 (以分钟为单位)")endifcall DisplayTextToPlayer(Player(0),0,0," ")if xV==1 thencall DisplayTimedTextToPlayer(Player(0),0,0,999,"游戏模式: |c0080FF00-rd, -dm, -av, -kg|r - 设置为 |c0000FFFF回合制|r.")elseif xV==2 thencall DisplayTimedTextToPlayer(Player(0),0,0,999,"游戏模式: |c0080FF00-rd, -dm, -av, -kg|r - 设置为 |c0000FFFF死亡竞赛|r.")elseif xV==3 thencall DisplayTimedTextToPlayer(Player(0),0,0,999,"游戏模式: |c0080FF00-rd, -dm, -av, -kg|r - 设置为 |c0000FFFF化身战|r.")elseif xV==4 thenif not VX thencall DisplayTimedTextToPlayer(Player(0),0,0,999,"游戏模式: |c0080FF00-rd, -dm, -av, -kg|r - 设置为 |c0000FFFF国王战|r.")elsecall DisplayTimedTextToPlayer(Player(0),0,0,999,"游戏模式: |c0080FF00-rd, -dm, -av, -kg|r - 设置为 |c0000FFFF国王战|r (已修复).")endifelseif xV==5 thencall DisplayTimedTextToPlayer(Player(0),0,0,999,"游戏模式: |c0080FF00-rd, -dm, -av, -kg|r - 设置为 |c0000FFFFKING OF THE HILL|r.")endifcall DisplayTimedTextToPlayer(Player(0),0,0,999,"|c0080FF00-teams|r 再次选择队伍")call DisplayTextToPlayer(Player(0),0,0," ")call DisplayTimedTextToPlayer(Player(0),0,0,999,"|c0080FF00-c1|r 或 |c0080FF00-c2|r 修改常数")call DisplayTimedTextToPlayer(Player(0),0,0,999,"|c0080FF00-gold|r |c00E8E800#####|r 设置开局金钱 (当前为 |c0000FFFF"+I2S(yo)+"|r)")if Cn thencall DisplayTimedTextToPlayer(Player(0),0,0,999,"|c0080FF00-square/circle/circle donut/square donut|r (当前为 |c0000FFFF默认|r)")elseif Mn==0 thenif fn thencall DisplayTimedTextToPlayer(Player(0),0,0,999,"|c0080FF00-square/circle/circle donut/square donut|r (当前为 |c0000FFFF圆环|r)")elsecall DisplayTimedTextToPlayer(Player(0),0,0,999,"|c0080FF00-square/circle/circle donut/square donut|r (当前为 |c0000FFFF圆形|r)")endifelseif Mn==1 thenif fn thencall DisplayTimedTextToPlayer(Player(0),0,0,999,"|c0080FF00-square/circle/circle donut/square donut|r (当前为 |c0000FFFF方形环|r)")elsecall DisplayTimedTextToPlayer(Player(0),0,0,999,"|c0080FF00-square/circle/circle donut/square donut|r (当前为 |c0000FFFF方形|r)")endifendifif not dn thencall DisplayTimedTextToPlayer(Player(0),0,0,999,"|cff80ff00-ice|r 为