kes nothing returns nothingif Kr[bi]thenreturnendifcall iI(true,bi,true,7337,false,0)set lr[bi]=trueset Kr[bi]=truecall JA(bi,KA(bi)+Jr/ 3.)set Mv[bi]=Ciset dv[bi]=dv[bi]+Kocall UnitAddAbility(M[bi],'Agho')call OI((function gb),((4*MV[Ni])*1.),(bi),($539),(be),0,0,0)call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl",U[bi],W[bi]))endfunctionfunction PC takes nothing returns nothinglocal real qCset TX=TX-U[bi]set TY=TY-W[bi]if Mr[bi]thenset br=bicall gA()endifif TX==U[bi]and TY==W[bi]thencall DisplayTextToPlayer(Player(bv[bi]),0,0,"错误: 请不要瞄准你的位置.")call IssueImmediateOrderById(M[bi],$D0004)elsecall IssueImmediateOrderById(M[bi],$D0004)set dr=SquareRoot(TX*TX+TY*TY)call SetUnitFacing(M[bi],Atan2(TY,TX)*bj_RADTODEG)set Mv[bi]=Ciif not Mr[bi]thenset dv[bi]=dv[bi]+loendifset Mr[bi]=trueset TX=TX/ drset TY=TY/ drset Z[bi]=.77*Lr*TXset vv[bi]=.77*Lr*TYset xv[bi]=mr*TXset ov[bi]=mr*TYset qC=900*(1+.12*Ri[Ni])if dr>qC thenset dr=qCendifset Ev[bi]=dr/ Lr*.03+3*.03endifendfunctionfunction QC takes nothing returns booleancall DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissile.mdl",U[br],W[br]))call KillUnit(M[br])call lR(br,false)return falseendfunctionfunction sC takes nothing returns booleanset fv[3*br+1]=falseset fv[3*br+2]=falseset fv[3*br+3]=falseif Nv[Br]==1 thencall sN(br,Br,2.5+.5*cv[br],.65)endifcall aA(br)return falseendfunctionfunction SC takes nothing returns booleancall SetUnitScale(M[br],.3,.3,.3)call DestroyEffect(AddSpecialEffectTarget("SplitterDeath.mdl",M[br],"origin"))call KillUnit(M[br])call lR(br,false)return falseendfunctionfunction tC takes nothing returns booleanif Le thencall SetUnitScale(M[br],Ev[br]*2.5+1,Ev[br]*2.5+1,Ev[br]*2.5+1)set cr=qR(2,bv[br],'e000',U[br],W[br],Lv[br]*bj_RADTODEG,"Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl")set dv[cr]=20set fv[cr*3+1]=trueset fv[cr*3+3]=trueset Mv[cr]=Naset qv[cr]=baset mv[cr]=Baset Ev[cr]=1set TX=750*.03*Cos(Lv[br])set TY=750*.03*Sin(Lv[br])set Z[cr]=TXset vv[cr]=TYset cv[cr]=cv[br]set lv[cr]=1set cr=qR(2,bv[br],'e000',U[br],W[br],Lv[br]*bj_RADTODEG,"Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl")set dv[cr]=20set fv[cr*3+1]=trueset fv[cr*3+3]=trueset Mv[cr]=Naset qv[cr]=baset mv[cr]=Baset Ev[cr]=1set Z[cr]=-TXset vv[cr]=-TYset cv[cr]=cv[br]set lv[cr]=1set Lv[br]=Lv[br]+30*bj_DEGTORADif Lv[br]>2*bj_PI thenset Lv[br]=Lv[br]-2*bj_PIendifendifreturn falseendfunctionfunction uC takes nothing returns booleanlocal real dxlocal real dylocal real URlocal real Dxlocal real Dycall SetUnitScale(M[br],Ev[br]*2.5+1,Ev[br]*2.5+1,Ev[br]*2.5+1)if Ev[br]/ .12-R2I(Ev[br]/ .12+.001)<.001 thenset dx=Z[br]set dy=vv[br]set UR=SquareRoot(dx*dx+dy*dy)set dx=dx/ URset dy=dy/ URset Dx=(dx-dy*Ev[br])/(1+Ev[br])set Dy=(dy+dx*Ev[br])/(1+Ev[br])set cr=qR(2,bv[br],'e000',U[br],W[br],0*bj_RADTODEG,"Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl")set cv[cr]=cv[br]set dv[cr]=21set fv[cr*3+1]=trueset fv[cr*3+3]=trueset Mv[cr]=Naset qv[cr]=baset mv[cr]=Baset Ev[cr]=1.2*(1+.12*Ri[bv[br]])set Z[cr]=600*.03*Dxset vv[cr]=600*.03*Dyset Dx=(dx+dy*Ev[br])/(1+Ev[br])set Dy=(dy-dx*Ev[br])/(1+Ev[br])set cr=qR(2,bv[br],'e000',U[br],W[br],0*bj_RADTODEG,"Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl")set cv[cr]=cv[br]set dv[cr]=21set fv[cr*3+1]=trueset fv[cr*3+3]=trueset Mv[cr]=Naset qv[cr]=baset mv[cr]=Baset Ev[cr]=1.2*(1+.12*Ri[bv[br]])set Z[cr]=600*.03*Dxset vv[cr]=600*.03*Dyendifreturn falseendfunctionfunction UC takes integer id,real dx,real dy,real x,real y returns nothinglocal integer vNset vN=qR(2,id,'e000',x,y,GetUnitFacing(M[bV[id]]),"Abilities\\Weapons\\SpiritOfVengeanceMissile\\SpiritOfVengeanceMissile.mdl")set fv[3*vN+3]=trueset cv[vN]=ri[id]set Ev[vN]=.12*4set Xv[vN]=1set dv[vN]=50set Pv[vN]=Cacall SetUnitScale(M[vN],Ev[vN]*2.5+1,Ev[vN]*2.5+1,Ev[vN]*2.5+1)call TR(vN,$FA*.03,x+dx,y+dy)endfunctionfunction wC takes nothing returns booleanlocal integer LA=-3local integer cO=svlocal boolean close=falselocal real anglevallocal real WCset dr=SquareRoot(Z[br]*Z[br]+vv[br]*vv[br])if dr==0 thenset TX=0set TY=1elseset TX=Z[br]/ drset TY=vv[br]/ drendifcall UC(bv[br],Z[br],vv[br],U[br],W[br])call SetUnitScale(M[br],.1,.1,.1)call DestroyEffect(AddSpecialEffectTarget("Blue_WarStompCaster.mdx",M[br],"origin"))call KillUnit(M[br])call lR(br,false)return falseendfunctionfunction yC takes nothing returns booleanif Nv[Br]==1 thencall sN(br,Br,3,1.4)endifset TX=U[Br]-U[br]set TY=W[Br]-W[br]set dr=SquareRoot(TX*TX+TY*TY)if dr==0 thenset TX=0set TY=1call BJDebugMsg("分支错误: 报告录像")elseset TX=TX/ drset TY=TY/ drendifif Nv[Br]==3 thenset iv[br]=-TXset av[br]=-TYendifset fv[3*br+1]=falseset fv[3*br+2]=falseset fv[3*br+3]=falsecall aA(br)return falseendfunctionfunction YC takes nothing returns booleanlocal real WClocal real anglevalcall SetUnitScale(M[br],.25,.25,.25)call DestroyEffect(AddSpecialEffectTarget("Blue_WarStompCaster.mdx",M[br],"origin"))set TX=iv[br]set TY=av[br]set dr=SquareRoot(TX*TX+TY*TY)if dr==0 thenset TX=Z[br]set TY=vv[br]elseset TX=iv[br]set TY=av[br]endifcall UC(bv[br],TX,TY,U[br],W[br])call KillUnit(M[br])call lR(br,false)return falseendfunctionfunction zC takes nothing returns nothinglocal integer vNlocal real ZC=700*(1+.12*Ri[Ni])call GO()set vN=qR(2,Ni,'e000',CX,CY,GetUnitFacing(M[bi]),"Abilities\\Weapons\\SpiritOfVengeanceMissile\\SpiritOfVengeanceMissile.mdl")set fv[3*vN+3]=trueset cv[vN]=ri[Ni]if Xn[Ni]thenset Ev[vN]=ZC/ 280set Xv[vN]=1set dv[vN]=50set Pv[vN]=caset Bv[vN]=17call SetUnitScale(M[vN],Ev[vN]*2.5+1,Ev[vN]*2.5+1,Ev[vN]*2.5+1)if(TX-CX)*(TX-CX)+(TY-CY)*(TY-CY)<$80*$80 thenset Ev[vN]=Ev[vN]*1.1elsecall TR(vN,280*.03,TX,TY)endifelseset Ev[vN]=(SquareRoot(eO(((TX)*1.),((TY)*1.),((CX)*1.),((CY)*1.))))if Ev[vN]>ZC thenset Ev[vN]=ZCendifset Ev[vN]=Ev[vN]/ 700set fv[3*vN+1]=trueset fv[3*vN+2]=trueset dv[vN]=50set Mv[vN]=daset mv[vN]=Daset qv[vN]=facall SetUnitScale(M[vN],2.5,2.5,2.5)call TR(vN,700*.03,TX,TY)endifset Lv[vN]=Atan2(vv[vN],Z[vN])endfunctionfunction vd takes nothing returns booleancall KillUnit(M[br])call lR(br,false)return falseendfunctionfunction ed takes nothing returns booleancall KillUnit(M[br])call lR(br,false)return falseendfunctionfunction xd takes nothing returns booleanset fv[3*br+1]=falseset fv[3*br+2]=falseset fv[3*br+3]=falseif Nv[Br]==1 thencall sN(br,Br,2.7+.3*cv[br],.6)endifcall DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIfb\\AIfbSpecialArt.mdl",U[br],W[br]))call aA(br)return falseendfunctionfunction od takes nothing returns booleancall KillUnit(M[br])call lR(br,false)return falseendfunctionfunction rd takes nothing returns booleanlocal real dxlocal real dylocal real URlocal real Dxlocal real Dylocal integer idlocal integer cOif Le thenset id=bv[br]set cO=bV[id]set dx=U[br]-U[cO]set dy=W[br]-W[cO]set UR=SquareRoot(dx*dx+dy*dy)set dx=dx/ URset dy=dy/ URset cr=qR(2,id,'e000',U[br],W[br],Atan2(dy,dx),"RepeaterMissile.mdx")call SetUnitColor(M[cr],GetPlayerColor(Player(id)))call SetUnitScale(M[cr],.4,.4,.4)set cv[cr]=cv[br]set dv[cr]=25set fv[cr*3+1]=trueset fv[cr*3+3]=trueset Mv[cr]=xnset qv[cr]=enset mv[cr]=enset Ev[cr]=.9*(1+.12*Ri[bv[br]])set Z[cr]=$3E8*.03*dxset vv[cr]=$3E8*.03*dyendifreturn falseendfunctionfunction ad takes nothing returns booleanif Bv[Br]==16 thencall aA(br)endifreturn falseendfunctionfunction nd takes nothing returns nothinglocal integer vNlocal real ZC='d'local real dx=TX-CXlocal real dy=TY-CYlocal real UR=SquareRoot(dx*dx+dy*dy)call GO()if UR>ZC thenset TX=CX+ZC*dx/ URset TY=CY+ZC*dy/ URendifset vN=qR(2,Ni,'e000',TX,TY,GetUnitFacing(M[bi]),"RepeaterMissile.mdx"