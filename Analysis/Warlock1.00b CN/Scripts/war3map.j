on tO takes nothing returns booleanlocal integer i=0local integer j=0local integer l=0loopexitwhen i==$Cif fV[i]thenif l==0 thenset l=1set j=gV[i]elseif j!=gV[i]thenreturn falseelseif Yn or xV==3 thenreturn falseendifendifset i=i+1endloopreturn trueendfunctionfunction TO takes integer uO,integer UO,integer wO,integer WO,integer yO,integer YO returns nothinglocal multiboarditem zO=MultiboardGetItem(OX[0],L[uO],UO)call MultiboardSetItemValueColor(zO,wO,WO,yO,YO)call MultiboardReleaseItem(zO)set zO=nullendfunctionfunction ZO takes nothing returns nothinglocal integer i=0local integer vR=0if Yn or xV==3 thenloopexitwhen i==$Cif ZV[i]>=vR and fV[i]thenset vR=ZV[i]endifset i=i+1endloopset i=0loopexitwhen i==$Cif fV[i]thenif ZV[i]==vR thencall TO(i,2,'d',$FF,'d',$FF)elsecall TO(i,2,$FF,$FF,$FF,$FF)endifendifset i=i+1endloopelseloopexitwhen i==$Cif ZV[gV[i]]>=vR and fV[i]thenset vR=ZV[gV[i]]endifset i=i+1endloopset i=0loopexitwhen i==$Cif fV[i]thenif ZV[gV[i]]==vR thencall TO(i,2,'d',$FF,'d',$FF)elsecall TO(i,2,$FF,$FF,$FF,$FF)endifendifset i=i+1endloopendifendfunctionfunction eR takes integer uO,integer UO,string DO returns nothinglocal multiboarditem zO=MultiboardGetItem(OX[0],L[uO],UO)call MultiboardSetItemValue(zO,DO)call MultiboardReleaseItem(zO)if UO==2 thencall ZO()endifset zO=nullendfunctionfunction xR takes integer id returns nothinglocal integer oR=MultiboardGetRowCount(OX[0])local multiboarditem zOcall MultiboardSetRowCount(OX[0],oR+1)set zO=MultiboardGetItem(OX[0],oR,0)call MultiboardSetItemStyle(zO,true,false)call MultiboardSetItemValue(zO,GetPlayerName(Player(id))+"|r")call MultiboardSetItemValueColor(zO,zV[3*gV[id]],zV[3*gV[id]+1],zV[3*gV[id]+2],$FF)call MultiboardSetItemWidth(zO,.075)call MultiboardReleaseItem(zO)set zO=MultiboardGetItem(OX[0],oR,1)call MultiboardSetItemValue(zO,"0")call MultiboardSetItemStyle(zO,true,false)call MultiboardSetItemWidth(zO,.025)call MultiboardReleaseItem(zO)set zO=MultiboardGetItem(OX[0],oR,2)call MultiboardSetItemValue(zO,"0")call MultiboardSetItemStyle(zO,true,false)call MultiboardSetItemWidth(zO,.033)call MultiboardReleaseItem(zO)set zO=MultiboardGetItem(OX[0],oR,3)call MultiboardSetItemValue(zO,"0")call MultiboardSetItemStyle(zO,true,false)call MultiboardSetItemWidth(zO,.025)call MultiboardReleaseItem(zO)set L[id]=oRendfunctionfunction rR takes nothing returns nothinglocal multiboarditem zOlocal integer i=0local integer oR=1set i=0set OX[0]=CreateMultiboard()set L[$C]=$Dcall MultiboardSetColumnCount(OX[0],4)call MultiboardSetRowCount(OX[0],rE+1)set zO=MultiboardGetItem(OX[0],0,0)call MultiboardSetItemValue(zO,"|cffffff00玩家|r")call MultiboardSetItemWidth(zO,.075)call MultiboardSetItemStyle(zO,true,false)call MultiboardReleaseItem(zO)set zO=MultiboardGetItem(OX[0],0,1)call MultiboardSetItemValue(zO,"|cffffff00击杀|r")call MultiboardSetItemWidth(zO,.025)call MultiboardSetItemStyle(zO,true,false)call MultiboardReleaseItem(zO)set zO=MultiboardGetItem(OX[0],0,2)call MultiboardSetItemValue(zO,"|cffffff00得分|r")call MultiboardSetItemWidth(zO,.033)call MultiboardSetItemStyle(zO,true,false)call MultiboardReleaseItem(zO)set zO=MultiboardGetItem(OX[0],0,3)call MultiboardSetItemValue(zO,"|cffffff00伤害|r")call MultiboardSetItemWidth(zO,.025)call MultiboardSetItemStyle(zO,true,false)call MultiboardReleaseItem(zO)loopexitwhen i>$Bif fV[i]thenset L[i]=oRset zO=MultiboardGetItem(OX[0],oR,0)call MultiboardSetItemStyle(zO,true,false)call MultiboardSetItemValue(zO,VO(i))call MultiboardSetItemWidth(zO,.075)call MultiboardReleaseItem(zO)set zO=MultiboardGetItem(OX[0],oR,1)call MultiboardSetItemValue(zO,"0")call MultiboardSetItemStyle(zO,true,false)call MultiboardSetItemWidth(zO,.025)call MultiboardReleaseItem(zO)set zO=MultiboardGetItem(OX[0],oR,2)call MultiboardSetItemValue(zO,"0")call MultiboardSetItemStyle(zO,true,false)call MultiboardSetItemWidth(zO,.033)call MultiboardReleaseItem(zO)set zO=MultiboardGetItem(OX[0],oR,3)call MultiboardSetItemValue(zO,"0")call MultiboardSetItemStyle(zO,true,false)call MultiboardSetItemWidth(zO,.025)call MultiboardReleaseItem(zO)set oR=oR+1endifset i=i+1endloopcall MultiboardSetTitleTextColor(OX[0],40,$FF,40,$FF)if zn thencall MultiboardSetTitleText(OX[0],"先到六分")elseif YE thencall MultiboardSetTitleText(OX[0],"剩余时间")elseif xV==2 thencall MultiboardSetTitleText(OX[0],"积分上限 = "+I2S(TE))endifcall MultiboardDisplay(OX[0],true)call MultiboardMinimize(OX[0],false)set zO=nullendfunctionfunction iR takes nothing returns nothingif(GetLocalPlayer()==GetTriggerPlayer())and RE thencall MultiboardDisplay(OX[1],false)call MultiboardDisplay(OX[0],true)endifendfunctionfunction aR takes nothing returns nothingif(GetLocalPlayer()==GetTriggerPlayer())and RE thencall MultiboardDisplay(OX[0],false)call MultiboardDisplay(OX[1],true)endifendfunctionfunction nR takes integer mX,integer x,integer y,string VR returns nothingset J=MultiboardGetItem(OX[mX],y,x)call MultiboardSetItemValue(J,VR)call MultiboardReleaseItem(J)endfunctionfunction ER takes integer mX,integer x,integer y,string VR,string XR returns nothingset J=MultiboardGetItem(OX[mX],y,x)call MultiboardSetItemStyle(J,true,true)call MultiboardSetItemValue(J,VR)call MultiboardSetItemIcon(J,XR)call MultiboardReleaseItem(J)endfunctionfunction OR takes integer mX,integer x,integer y,string XR returns nothingset J=MultiboardGetItem(OX[mX],y,x)call MultiboardSetItemStyle(J,false,true)call MultiboardSetItemIcon(J,XR)call MultiboardReleaseItem(J)endfunctionfunction RR takes integer mX,integer x,real IR returns nothinglocal integer i=0loopexitwhen i>MultiboardGetRowCount(OX[mX])set J=MultiboardGetItem(OX[mX],i,x)call MultiboardSetItemWidth(J,IR)call MultiboardReleaseItem(J)set i=i+1endloopendfunctionfunction AR takes integer mX,integer x,integer y,real IR returns nothingset J=MultiboardGetItem(OX[mX],y,x)call MultiboardSetItemWidth(J,IR)call MultiboardReleaseItem(J)endfunctionfunction NR takes nothing returns nothinglocal integer i=1loopexitwhen i>500set Rv[i]=i+1set i=i+1endloopendfunctionfunction bR takes real x1,real y1,real x2,real y2 returns realset x1=x2-x1set y1=y2-y1return SquareRoot(x1*x1+y1*y1)endfunctionfunction BR takes real x1,real y1,real x2,real y2 returns realset x1=x2-x1set y1=y2-y1return x1*x1+y1*y1endfunctionfunction cR takes integer CR,integer DR returns realreturn BR(U[CR],W[CR],U[DR],W[DR])endfunctionfunction fR takes integer CR,integer DR returns realreturn bR(U[CR],W[CR],U[DR],W[DR])endfunctionfunction FR takes real DO,boolean gR returns reallocal real GRif gR thenset GR=360elseset GR=360*bj_DEGTORADendifloopexitwhen DO>=0set DO=DO+GRendlooploopexitwhen DO<=GRset DO=DO-GRendloopreturn DOendfunctionfunction hR takes real a returns integerif a<0 thenreturn-1endifreturn 1endfunctionfunction HR takes real r returns integerif r<0 thenset r=r-$80endifreturn R2I(r/ $80+.5)endfunctionfunction jR takes integer id,integer JR returns nothinglocal integer nif id==0 or Av[id]thenreturnendifset Rv[id]=0set Iv[id]=0set Av[id]=trueif JR==1 thenset Rv[id]=svif sv!=0 thenif Iv[sv]!=0 thenset Iv[id]=Iv[sv]set Rv[Iv[sv]]=idendifset Iv[sv]=idelseif Qv!=0 thenset n=Qvloopexitwhen Rv[n]==0set n=Rv[n]endloopset Rv[n]=idset Iv[id]=nendifif sv==Qv thenset Qv=idendifset sv=idelseif JR==2 or JR==3 thenset Rv[id]=Qvif Qv!=0 thenset Iv[Qv]=idendifset Qv=idendifendfunctionfunction kR takes integer id returns nothingif id==0 thenreturnendifif Av[id]thenif Rv[id]!=0 thenset Iv[Rv[id]]=Iv[id]endifif Iv[id]!=0 thenset Rv[Iv[id]]=Rv[id]endifif id==Qv thenset Qv=Rv[id]endifif id==sv thenset sv=Rv[id]endifset Rv[id]=0set Iv[id]=0set Av[id]=falseendifendfunctionfunction KR takes integer JR returns integerlocal integer id=1if JR!=1 and JR!=2 and JR!=3 thenreturn 0endifset id=Svset Sv=Rv[id]call jR(id,JR)set Nv[id]=JRset M[id]=nullset q[id]=nullset Q[id]=nullset S[id]=nullset U[id]=0set W[id]=0set Y[id]=moset Z[id]=0set vv[id]=0set ev[id]=0set xv[id]=0set ov[id]=0set rv[id]=0set iv[id]=0set av[id]=0set nv[id]=falseset Vv[id]=Moset dv[id]=0set lv[id]=0set Lv[id]=0set Xv[id]=-1set Ov[id]=1set Ev[id]=0set Jv[id]=falseset Kv[id]=falseset Bv[id]=0set cv[id]=0set Cv[id]=falseset Dv[id]=0set fv[id*3+1]=falseset fv[id*3+2]=falseset fv[id*3+3]=falseset hv[id]=0set Fv[id]=falseset gv[id]=falseset Hv[id]=falseset jv[id]=0set mv[id]=nullset Mv[id]=nullset pv[id]=nullset Pv[id]=nullset qv[id]=nullreturn idendfunctionfunction lR takes integer id,boolean LR returns nothingif id==0 thenreturnendifif M[id]!=null thencall SetUnitUserData(M[id],0)if LR thencall RemoveUnit(M[id])endifendifif q[id]!=null thencall DestroyEffect(q[id])endifif Q[id]!=null thencall DestroyLightning(Q[id])endifif S[id]!=null thencall DestroyTextTag(S[id])endifif Nv[id]!=0 and Av[id]thenset Nv[id]=0if Rv[id]!=0 thenset Iv[Rv[id]]=Iv[id]endifif Iv[id]!=0 thenset Rv[Iv[id]]=Rv[id]endifif id==Qv thenset Qv=Rv[id]endifif id==sv thenset sv=Rv[id]endifendifset Av[id]=falseset Nv[id]=0set M[id]=nullset q[id]=nullset Q[id]=nullset S[id]=nullset U[id]=0set W[id]=0set Y[id]=moset Z[id]=0set vv[id]=0set ev[id]=0set xv[id]=0set ov[id]=0set rv[id]=0set iv[id]=0set av[id]=0set nv[id]=falseset Vv[id]=Moset dv[id]=0set lv[id]=0set Lv[id]=0set Xv[id]=-1set Ov[id]=1set Ev[id]=0set Jv[id]=falseset Kv[id]=falseset Bv[id]=0set cv[id]=0set Cv[id]=falseset Dv[id]=0set fv[id*3+1]=falseset fv[id*3+2]=falseset fv[id*3+3]=falseset hv[id]=0set Fv[id]=falseset gv[id]=falseset Hv[id]=falseset jv[id]=0set mv[id]=nullset Mv[id]=nullset pv[id]=nullset Pv[id]=nullset qv[id]=nullset Rv[id]=Svset Sv=idendfunctionfunction mR takes integer cO,boolean MR returns nothingif MR thenset nv[cO]=trueelseset nv[cO]=falsecall SetUnitFlyHeight(M[cO],Vv[cO],0)set Y[cO]=moset ev[cO]=0set rv[cO]=0endifendfunctionfunction pR takes integer cO,boolean MR,real PR returns nothingset Vv[cO]=PRcall mR(cO,MR)endfunctionfunction qR takes integer JR,integer QR,integer sR,real x,real y,real SR,string tR returns integerlocal integer cO=KR(JR)set M[cO]=CreateUnit(Player(QR),sR,x,y,SR)call SetUnitPathing(M[cO],false)set bv[cO]=QRcall UnitAddAbility(M[cO],'Amrf')call UnitRemoveAbility(M[cO],'Amrf')call SetUnitUserData(M[cO],cO)call SetUnitX(M[cO],x)call SetUnitY(M[cO],y)call mR(cO,false)if tR!="" thenset q[cO]=AddSpecialEffectTarget(tR,M[cO],"origin")endifset U[cO]=xset W[cO]=yset bv[cO]=QRif Ev[cO]!=0 thencall BJDebugMsg("物体 "+I2S(cO)+" 创建至目标区域="+R2S(Ev[cO]))set Ev[cO]=0endifreturn cOendfunctionfunction TR takes integer cO,real uR,real x,real y returns nothinglocal real URset x=x-U[cO]set y=y-W[cO]set UR=x*x+y*yif not(UR==0)thenset UR=SquareRoot(UR)set Z[cO]=Z[cO]+uR*x/ URset vv[cO]=vv[cO]+uR*y/ URendifendfunctionfunction wR takes integer cO,real uR,real x,real y returns nothinglocal real URset x=x-U[cO]set y=y-W[cO]set UR=x*x+y*yif not(UR==0)thenset UR=SquareRoot(UR)set Z[cO]=uR*x/ URset vv[cO]=uR*y/ URendifendfunctionfunction GetTime takes nothing returns realreturn(Uv+TimerGetElapsed(uv))endfunctionfunction WR takes nothing returns nothingset Uv=Uv+.05endfunctionfunction yR takes integer vO returns stringif vO>9 thenreturn I2S(vO)endifreturn"0"+I2S(vO)endfunctionfunction YR takes nothing returns stringlocal integer vO=R2I((Uv+TimerGetElapsed(uv)))local integer zR=ModuloInteger(vO,60)if zR>9 thenreturn"|c00008000"+I2S(vO/ 60)+":"+I2S(zR)+"|r "elsereturn"|c00008000"+I2S(vO/ 60)+":0"+I2S(zR)+"|r "endifendfunctionfunction ZR takes string vI returns nothingif ce thencall DisplayTextToPlayer(Player(0),0,0,YR()+vI)elsecall DisplayTextToPlayer(GetLocalPlayer(),0,0,YR()+vI)endifendfunctionfunction eI takes nothing returns nothinglocal integer id=Zvset ae=ee[id*3]set ne=ee[id*3+1]set Ve=ee[id*3+2]set Ee=xe[id*3]set Xe=xe[id*3+1]set Oe=xe[id*3+2]set Re=oe[id]set Ie=re[id]set Ae=ie[id]call TriggerExecute(yv[id])call TriggerClearActions(yv[id])set ee[id*3]=0set ee[id*3+1]=0set ee[id*3+2]=0set xe[id*3]=0set xe[id*3+1]=0set xe[id*3+2]=0set oe[id]=nullset re[id]=nullset ie[id]=nullset Tv[id]=-1set zv[Yv[id]]=zv[id]set Yv[zv[id]]=Yv[id]if Zv==id thenset Zv=Yv[id]if Zv!=0 thenif Tv[Zv]>(Uv+TimerGetElapsed(uv))thencall TimerStart(Wv,Tv[Zv]-(Uv+TimerGetElapsed(uv)),false,function eI)elsecall eI()endifelsecall PauseTimer(Wv)endifendifset Yv[id]=veset zv[id]=0set ve=idendfunctionfunction xI takes integer id returns nothingset zv[Yv[id]]=zv[id]set Yv[zv[id]]=Yv[id]if Zv==id thenset Zv=Yv[id]if Zv!=0 thenif Tv[Zv]>(Uv+TimerGetElapsed(uv))thencall TimerStart(Wv,Tv[Zv]-(Uv+TimerGetElapsed(uv)),false,function eI)elsecall eI()endifelsecall PauseTimer(Wv)endifendifset Yv[id]=veset zv[id]=0set ve=idendfunctionfunction oI takes integer id returns nothingset ae=ee[id*3]set ne=ee[id*3+1]set Ve=ee[id*3+2]set Ee=xe[id*3]set Xe=xe[id*3+1]set Oe=xe[id*3+2]set Re=oe[id]set Ie=re[id]set Ae=ie[id]call TriggerExecute(yv[id])call TriggerClearActions(yv[id])set ee[id*3]=0set ee[id*3+1]=0set ee[id*3+2]=0set xe[id*3]=0set xe[id*3+1]=0set xe[id*3+2]=0set oe[id]=nullset re[id]=nullset ie[id]=nullset Tv[id]=-1set zv[Yv[id]]=zv[id]set Yv[zv[id]]=Yv[id]if Zv==id thenset Zv=Yv[id]if Zv!=0 thenif Tv[Zv]>(Uv+TimerGetElapsed(uv))thencall TimerStart(Wv,Tv[Zv]-(Uv+TimerGetElapsed(uv)),false,function eI)elsecall eI()endifelsecall PauseTimer(Wv)endifendifset Yv[id]=veset zv[id]=0set ve=idendfunctionfunction rI takes integer id returns nothingcall TriggerClearActions(yv[id])set ee[id*3]=0set ee[id*3+1]=0set ee[id*3+2]=0set xe[id*3]=0set xe[id*3+1]=0set xe[id*3+2]=0set Tv[id]=-1call xI(id)endfunctionfunction iI takes boolean c1,integer d1,boolean c2,integer d2,boolean c3,integer d3 returns nothinglocal integer i=Zvlocal integer aIset c1=not c1set c2=not c2set c3=not c3loopexitwhen i==0set aI=Yv[i]if(c1 or ee[i*3]==d1)and(c2 or ee[i*3+1]==d2)and(c3 or ee[i*3+2]==d3)thencall oI(i)endifset i=aIendloopendfunctionfunction nI takes boolean c1,integer d1,boolean c2,integer d2,boolean c3,integer d3 returns reallocal integer i=Zvlocal integer aIlocal real VI=0set c1=not c1set c2=not c2set c3=not c3loopexitwhen i==0set aI=Yv[i]if(c1 or ee[i*3]==d1)and(c2 or ee[i*3+1]==d2)and(c3 or ee[i*3+2]==d3)thenset VI=xe[i*3]call oI(i)endifset i=aIendloopreturn VIendfunctionfunction EI takes boolean c1,integer d1,boolean c2,integer d2,boolean c3,integer d3 returns nothinglocal integer i=Zvlocal integer aIset c1=not c1set c2=not c2set c3=not c3loopexitwhen i==0set aI=Yv[i]if(c1 or ee[i*3]==d1)and(c2 or ee[i*3+1]==d2)and(c3 or ee[i*3+2]==d3)thencall rI(i)endifset i=aIendloopendfunctionfunction XI takes boolean c1,integer d1,boolean c2,integer d2,boolean c3,integer d3 returns integerlocal integer i=Zvlocal integer aIset c1=not c1set c2=not c2set c3=not c3loopexitwhen i==0set aI=Yv[i]if(c1 or ee[i*3]==d1)and(c2 or ee[i*3+1]==d2)and(c3 or ee[i*3+2]==d3)thenreturn iendifset i=aIendloopreturn 0endfunctionfunction OI takes code RI,real II,integer d1,integer d2,integer d3,real r1,real r2,real r3 returns integerlocal integer id=velocal integer AI=Zvif yv[id]==null thenset yv[id]=CreateTrigger()endifcall TriggerAddAction(yv[id],RI)set ee[id*3]=d1set ee[id*3+1]=d2set ee[id*3+2]=d3set xe[id*3]=r1set xe[id*3+1]=r2set xe[id*3+2]=r3set oe[id]=nullset re[id]=nullset ie[id]=nullset ve=Yv[ve]set Tv[id]=II+(Uv+TimerGetElapsed(uv))loopexitwhen AI==0 or Tv[AI]>Tv[id]set AI=Yv[AI]endloopset Yv[id]=AIset Yv[zv[AI]]=idset zv[id]=zv[AI]set zv[AI]=idif AI==Zv or Zv==0 thenset Zv=idcall TimerStart(Wv,Tv[id]-(Uv+TimerGetElapsed(uv)),false,function eI)endifreturn idendfunctionfunction NI takes nothing returns nothinglocal integer i=1set Wv=CreateTimer()set wv=CreateTimer()call TimerStart(wv,$98967F,false,null)set uv=CreateTimer()call TimerStart(uv,.05,true,function WR)loopexitwhen i>tvset zv[i]=0set Yv[i]=i+1set yv[i]=nullset Tv[i]=-1set ee[i*2]=0set ee[i*2+1]=0set ee[i*2+2]=0set i=i+1endloopendfunctionfunction bI takes integer BI,integer cI,real CI returns nothingset Vr=focall DisplayTimedTextToPlayer(Player(BI),0,0,CI," ")call DisplayTimedTextToPlayer(Player(BI),0,0,CI,"|cffffcc00(提示 "+I2S(cI)+"/"+I2S(Ce)+")|r")call DisplayTimedTextToPlayer(Player(BI),0,0,CI,de[cI])if(GetLocalPlayer()==Player(BI))thencall StartSound(Vr)endifendfunctionfunction dI takes integer BI,integer DI,real CI returns nothingset Vr=Docall DisplayTimedTextToPlayer(Player(BI),0,0,CI," ")call DisplayTimedTextToPlayer(Player(BI),0,0,CI,"|cffffcc00(步骤 "+I2S(DI)+"/"+I2S(De)+")|r "+fe[DI])call DisplayTimedTextToPlayer(Player(BI),0,0,CI,Fe[DI])if(GetLocalPlayer()==Player(BI))thencall StartSound(Vr)endifendfunctionfunction fI takes integer FI returns nothinglocal integer i=0local real CI=50if(xV!=2 and xV!=5)thenset CI=TimerGetRemaining(uE)endifloopexitwhen i>$Bif(EX[i]and fV[i])thenif(Ge[i]and FI<De)thencall dI(i,FI+1,CI)endifif(ge[i]and FI>0)thencall bI(i,GetRandomInt(1,Ce),CI)endifendifset i=i+1endloopendfunctionfunction gI takes integer BI returns nothingif(EX[BI]and ge[BI])thencall bI(BI,GetRandomInt(1,Ce),20)endifendfunctionfunction GI takes nothing returns nothinglocal string slocal string clocal integer BIif(not EX[BI])thenreturnendifif(SubString(s,0,1)!="-")thenreturnendifset s=GetEventPlayerChatString()set c=""set BI=GetPlayerId(GetTriggerPlayer())if(s=="-ttutorial")thenset Ge[BI]=not Ge[BI]elseif(s=="-thint" or s=="-thints")thenset ge[BI]=not ge[BI]elseif(SubString(s,0,5)=="-hint")thenset c=SubString(s,6,StringLength(s))if(S2I(c)>=1 and S2I(c)<=Ce)thencall bI(BI,S2I(c),20)elseif(s=="-hint")thencall bI(BI,GetRandomInt(1,Ce),20)endifelseif(SubString(s,0,5)=="-step")thenset c=SubString(s,6,StringLength(s))if(S2I(c)>=1 and S2I(c)<=De)thencall dI(BI,S2I(c),40)endifendifendfunctionfunction hI takes string HI returns nothingset Ce=Ce+1set de[Ce]=HIendfunctionfunction jI takes string JI,string HI returns nothingset De=De+1set fe[De]=JIset Fe[De]=HIendfunctionfunction kI takes nothing returns nothinglocal integer i=0local trigger t=CreateTrigger()local string KI="|cff41668b"local string VR="|cff7fa1c3"local string lI="|cffe9eff5"local string LI="|cffff0000"local string mI="|cffff9933"local string MI="|cffff9696"local string pI="|cff6969ff"local string PI="|cffcccc33"local string qI="|cffccff99"local string QI="|cff6633ff"local string sI="|cffa020f0"local string SI="|cffc8000a"local string tI="|cffffff00"local string TI="|cffdaa520"local string uI="|cff68cc33"call jI(KI+"欢迎来到教程!|r",VR+"首先要做的是选择你的 "+lI+"商人"+VR+" 然后点击 "+lI+"初级法术"+VR+". 建议你在开局时从R类法术组中选择一个 "+LI+"R"+VR+" 法术, 分别是 "+pI+"瞬间移动"+VR+", "+pI+"疾速移动"+VR+" 或 "+pI+"移形换位"+VR+". 当你买完其中一个法术, 马上就可以使用它了.|r")call jI(KI+"更多法术|r",VR+"最好在拥有一套完整的法术后再升级你学过的法术. 如果你已经有了一个 "+LI+"R"+VR+" 法术, 你应该考虑学习一个 "+LI+"D"+VR+" 法术 ("+MI+"闪电"+VR+", "+MI+"回旋镖"+VR+", "+MI+"追踪球"+VR+") 或一个 "+LI+"T"+VR+" 法术 ("+PI+"汲取"+VR+", "+PI+"火焰喷射"+VR+", "+PI+"弹跳球"+VR+") 也不错. 如果你还没学习一个 "+LI+"R"+VR+" 法术, 现在赶紧学习吧. 这是你最重要的法术, 因为它可以让你在危险的情况下逃脱.|r")call jI(KI+"法术相辅相成|r",VR+"现在, 你应该已经从法术书里面挑选完法术并且退出 "+lI+"初级法术"+VR+". 一个 "+LI+"D"+VR+", "+LI+"R"+VR+" 或 "+LI+"T"+VR+" 法术. 现在你应该通过实战来尝试使用法术的连击, 蘸个痛吧! 施放 "+mI+"火球"+VR+" 后立即施放 "+MI+"闪电"+VR+" 能爆出一个AOE击飞对手; 用 "+PI+"汲取"+VR+" 来吸取对方生命并且减慢对方移动速度, 让你更容易瞄准对手; "+pI+"瞬间移动"+VR+" 至对方身边迅速 "+SI+"天罚"+VR+" 的进攻会让你的 "+LI+"R"+VR+" 法术更有特点; 一切皆有可能.|r")call jI(KI+"选定你的发展路线|r",VR+"接下来你可以更自由地搭配法术. 你还可以从另一本法术书 "+lI+"辅助法术"+VR+" 上学习更多的法术. 通常我们会先选择一个 "+LI+"C"+VR+" 法术 ("+QI+"急行"+VR+", "+QI+"反射盾"+VR+", "+QI+"时光回溯"+VR+") . 由于他们的防御特性, 你会明白你的 "+LI+"R"+VR+" 法术至关重要. 一个 "+LI+"E"+VR+" 法术 ("+qI+"陨石"+VR+", "+qI+"疾风步"+VR+", "+qI+"分裂弹"+VR+") 会让你更具有进攻性并且法术连击更为多变. "+LI+"Y"+VR+" 法术 ("+sI+"锁链"+VR+", "+sI+"禁锢"+VR+", "+sI+"引力"+VR+") 比起另外两个辅助法术直接杀伤力稍逊一筹, 但是另有可以配合诸多法术, 妙用无穷.|r")call jI(KI+"选定你的发展路线续|r",VR+"当你从 "+lI+"辅助法术"+VR+" 学习了一个法术后, 你还想再学一个, 不论是立刻还是下一个回合休息时间, 请认真考虑你的资金分配.|r")call jI(KI+"快捷键|r",VR+"新手总是苦恼于无法熟练运用快捷键打出随心所欲的组合, 不要苦恼哦, 这是每位术士玩家必须练习的基本功, 就像练功之前需要练扎稳马步一样.|r")call jI(KI+"进阶你的发展路线|r",VR+"当你有了5-8个可以灵活组合应用的法术后, 你大可升级你的法术. 比如你想跳过学习 "+LI+"Y"+VR+" 法术, 你可以 "+lI+"1)"+VR+" 升级你所拥有的法术, "+lI+"2)"+VR+" 购买物品, "+lI+"3)"+VR+" 升级精通. 选择一个 "+lI+"初级法术"+VR+" 升级是良好的开始, 或者购买一双 "+TI+"速度之靴"+VR+" 这样的基础物品.|r")call jI(KI+"进阶你的发展路线续|r",VR+"升级你的 "+lI+"法术"+VR+" 通常会增加法术伤害或(并)减少冷却时间, 和其他一些效果. "+lI+"物品"+VR+" 有很多不同的功能, 我们最经常购买的是 "+TI+"速度之靴"+VR+" and "+TI+"熔岩靴"+VR+" 来增加移动速度. "+lI+"精通"+VR+" 能增强术士的法术 "+uI+"距离"+VR+", "+uI+"生命偷取"+VR+" 或 "+uI+"作用范围"+VR+", 有时也是某些法术升级的必要条件.|r")call jI(KI+"进阶你的发展路线再续|r",VR+"你可以在回合休息间继续按照上述两种方法构建你的术士. 升级你的法术, 购买物品或升级精通. 你也可以学习 "+LI+"Y"+VR+" 法术 (如果你还没有学的话) .|r")call jI(KI+"法术切换|r",VR+"你可能已经注意到, 一些法术当你学习后, 在商店里他们下边会有一个按钮. 点击按钮来切换对应的法术模式, 使他们变成概念上类似的全新法术. 多试试; 这不会消耗你的金钱.|r")call jI(KI+"辅助工具|r",VR+"你将会在术士的网站找到各种各样的工具 (这是一个国外的网站) , "+lI+"www.WarlockBrawl.com"+VR+". 包括: "+lI+"术士改键器"+VR+", 允许你去个性化热键. "+lI+"CTE"+VR+", 一个允许你创建自己地形的自定义地形编辑器. 还有 "+lI+"术士模拟加点器"+VR+", 用来计算你构建一套完整的法术, 精通和物品所花的金钱.|r")call hI(VR+"访问 "+lI+"www.WarlockBrawl.com"+VR+" 查看最新资讯, 提交你对术士之战的意见, 注册并参与官方比赛并成为术士大家庭中的一份子 (国内玩家可以考虑自己的网络条件酌情忽略此条) .|r")call hI(VR+""+lI+"头衔"+VR+" 奖励给赢得正式比赛的玩家或在游戏开发中做出贡献的玩家, 在游戏中给玩家的名字前面添加一个自定义颜色的词或短语 (参与汉化版的汉化与测试有几率获得头衔) .|r")call hI(VR+"你需要擅用 "+lI+"停止命令"+VR+" (快捷键为 "+LI+"S"+VR+") 用来取消大部分法术的施法. 特别是在用 "+SI+"天罚"+VR+"时使用S, 能够造成 '"+lI+"虚晃一枪"+VR+"' 的效果.|r")call hI(VR+"有些法术有两种模式, 可以在你的魔法书里切换它们.|r")call hI(VR+"随着时间的流逝竞技场会变小, 屏幕上方的时钟每转一圈竞技场会缩小一次.|r")call hI(VR+"快速连招能给你的对手瞬间造成毁灭性打击.")call hI(VR+"灵活的走位配合 "+SI+"天罚"+VR+" 会占尽优势.")call hI(VR+"你的 "+LI+"R"+VR+" 是最重要的法术, 请谨慎使用; 当R冷却时也是你最危险的时候.|r")call hI(VR+"当玩家用 "+QI+"时光回溯"+VR+" 的时候, 将会有一个 "+lI+"后摇动作"+VR+". 当你用时光回溯时, 记住利用走位和施法后摇来隐蔽这个动作.|r")call hI(VR+"当你身体碰到你发出的 "+MI+"追踪球"+VR+" 会造成一个AOE爆炸效果击伤附近的敌人.|r")call hI(VR+"在 "+pI+"疾速移动"+VR+" ("+tI+"冲撞"+VR+") 的过程中使用 "+QI+"时光回溯"+VR+" , 回溯后会按照惯性向前冲刺一段距离.|r")call hI(VR+"一些法术在使用后还可以再次点击, 会有特殊效果. 比如 "+sI+"锁链"+VR+" ("+tI+"蓝链"+VR+" and "+tI+"红链"+VR+"), "+QI+"时光回溯"+VR+" 和 "+pI+"瞬间移动"+VR+" ("+tI+"折跃"+VR+") .|r")call hI(VR+""+QI+"反射盾"+VR+" 无法抵挡范围伤害.|r")call hI(VR+"最好不要每轮都把钱花光, 这并不是最佳的选择, 有时候可以把钱留到下一轮购买较贵的法术.|r")call hI(VR+"如果在 "+qI+"疾风步"+VR+" ("+tI+"隐身"+VR+") 状态下使用 "+pI+"疾速移动"+VR+" ("+tI+"驭凤"+VR+") , 你的凤凰就会往前射出, 并对击中的目标造成伤害.|r")call hI(VR+"使用 "+PI+"汲取"+VR+" ("+tI+"虚弱"+VR+") 命中队友将增加该队友的攻击力并且转向对手继续攻击, 有短暂加速.|r")call hI(VR+"使用 "+qI+"分裂弹"+VR+" ("+tI+"爆裂"+VR+") 打向柱子将会在柱子上爆炸后分裂出小球向你方向反弹.|r")call hI(VR+"使用 "+qI+"疾风步"+VR+" ("+tI+"影袭"+VR+") 配合 "+pI+"疾速移动"+VR+" ("+tI+"冲撞"+VR+") 能产生更高的伤害与击退.|r")call hI(VR+"尽量呆在场地中间部分, 占据地利.|r")call hI(VR+"使用你的 "+LI+"C"+VR+" 法术或者 "+SI+"天罚"+VR+" 可以挣脱 "+sI+"锁链"+VR+" .|r")call hI(VR+"使用你的 "+MI+"闪电"+VR+" 引爆 "+mI+"火球"+VR+" 能造成一个AOE范围伤害.|r")call hI(VR+"预判对方的走位再进行攻击, 而不是瞄准他现在的位置进行攻击.|r")call hI(VR+"预判 "+lI+"对方的走位"+VR+" 计算好用 "+SI+"天罚"+VR+" 的时间, 在他的必经之路上放出天罚.|r")call hI(VR+"藏在柱子后面是躲避法术的好方法, 但是要注意柱子的HP. 当柱子被打爆时, 会击退附近的玩家并且增加击退值.|r")loopexitwhen i>$Bset ge[i]=trueset Ge[i]=truecall TriggerRegisterPlayerChatEvent(t,Player(i),"-",false)set i=i+1endloopcall TriggerAddAction(t,function GI)endfunctionfunction UI takes gamecache wI,string WI,string yI,integer i returns nothingcall StoreInteger(wI,WI,yI,i)call SyncStoredInteger(wI,WI,yI)call FlushStoredInteger(wI,WI,yI)endfunctionfunction YI takes nothing returns nothingset He=InitGameCache("mapid")call UI(He,"i","d",2)set je=InitGameCache("meta")call UI(je,"a","fbcast",0)call UI(je,"b","fbhit",0)call UI(je,"c","apm",0)call UI(je,"d","score",0)call UI(je,"e","Kills",0)call UI(je,"f","Deaths",0)call UI(je,"g","Assists",0)endfunctionfunction zI takes nothing returns nothinglocal trigger t=CreateTrigger()call TriggerAddAction(t,function YI)call TriggerRegisterTimerEvent(t,0,false)set he=InitGameCache("d")endfunctionfunction ZI takes integer i returns stringif(i<$A)thenreturn I2S(i)elseif(i==$A)thenreturn":"endifif(i==$B)thenreturn";"endifendifreturn""endfunctionfunction vA takes string WI,string yI,integer i returns nothingcall StoreInteger(he,WI,yI,i)call SyncStoredInteger(he,WI,yI)call FlushStoredInteger(he,WI,yI)endfunctionfunction eA takes nothing returns nothinglocal integer i=0local player plocal string xAlocal integer oA=0local integer rA=0local integer iA=-1loopexitwhen(i>=$C)set p=Player(i)if(GetPlayerSlotState(p)!=PLAYER_SLOT_STATE_EMPTY and GetPlayerController(p)==MAP_CONTROL_USER and gV[i]!=$C)thenset xA=ZI(i)call vA("a",xA,SE[2*i])call vA("b",xA,SE[2*i+1])if(DV[i]and fV[i])thencall vA("c",xA,R2I(60*JE[i]/(KE[i]+TimerGetElapsed(wv)-lE[i])))elseif(fV[i])thencall vA("c",xA,R2I(60*JE[i]/ KE[i]))endifcall vA("d",xA,ZV[gV[i]])call vA("e",xA,BV[3*i])call vA("f",xA,BV[3*i+1])call vA("g",xA,BV[3*i+2])endifset i=i+1endlooploopexitwhen(rA>=$C)if((ZV[gV[rA]]>iA)and(GetPlayerSlotState(Player(rA))==PLAYER_SLOT_STATE_PLAYING))thenset iA=ZV[gV[rA]]endifset rA=rA+1endloopif(iA!=0)thenset rA=0loopexitwhen(rA>=$C)if(ZV[gV[rA]]==iA)thenset oA=oA+R2I(Pow(2,rA))endifset rA=rA+1endloopendifcall UI(He,"w","0",oA)endfunctionfunction aA takes integer cO returns nothingset le=le+1set Ke[le]=cOendfunctionfunction nA takes integer VA,integer id,real DO returns nothingset lv[VA]=idif Lv[VA]!=0 thenif Kv[VA]and Ax[VA]==985 thenset Ev[VA]=Fxset Lv[VA]=0set Pv[VA]=kxset mv[VA]=jxset S[VA]=CreateTextTag()call SetTextTagText(S[VA],R2S(Fx),.025)call SetTextTagColor(S[VA],$FF,30,30,$FF)elseset Lv[VA]=Lv[VA]-DOif Lv[VA]<.1 thenset fv[3*VA+1]=falseset fv[3*VA+2]=falseset fv[3*VA+3]=falsecall aA(VA)call DestroyTextTag(S[VA])set S[VA]=nullelsecall SetTextTagText(S[VA],R2SW(Lv[VA],3,1),.025)if Lv[VA]<$F a