,2,I2S(ZV[i]))endifset i=i+1endloopcall SetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD)+so+So)endifendifelseif DN>0 and dN!=$C thenif dN!=ON thenset ss=ss+" ("+FV[dN]+"|r)"call SA(dN,1)set ZV[gV[dN]]=ZV[gV[dN]]+Qoset i=0loopexitwhen i>$Bif fV[i]and gV[i]==gV[dN]thencall eR(i,2,I2S(ZV[gV[dN]]))endifset i=i+1endloopset ZV[gV[ON]]=ZV[gV[ON]]+qoset i=0call SetPlayerState(Player(dN),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(dN),PLAYER_STATE_RESOURCE_GOLD)+so)call SetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD)+so)elseif dN==ON thenset ZV[gV[ON]]=ZV[gV[ON]]+qo+Qocall SetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD)+so+So)endifset i=0loopexitwhen i>$Bif fV[i]and gV[i]==gV[ON]thencall eR(i,2,I2S(ZV[gV[i]]))endifset i=i+1endloopendifendifcall ShowUnit(AV[cN],false)call kR(bV[cN])call zX(ss+s)call VN()elseif xV==2 or xV==5 thenset cV[$C+cN]=cV[$C+cN]+cV[cN]set i=0loopexitwhen i>$Bif fV[i]thenset fN=wV[cN*$C+i]if fN>DN thenset DN=fNset dN=iendifendifset i=i+1endloopif Yn thenif DN>0 and dN!=$C thenif dN!=ON thenset ss=ss+" ("+FV[dN]+"|r)"call SA(dN,1)endifcall SetPlayerState(Player(dN),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(dN),PLAYER_STATE_RESOURCE_GOLD)+so)set ZV[dN]=ZV[dN]+Qocall eR(dN,2,I2S(ZV[dN]))endifcall SetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD)+so)set ZV[ON]=ZV[ON]+qocall eR(ON,2,I2S(ZV[ON]))set ZV[cN]=ZV[cN]-1call eR(cN,2,I2S(ZV[cN]))elseif DN>0 and dN!=$C thenif dN!=ON thenset ss=ss+" ("+FV[dN]+"|r)"call SA(dN,1)endifcall SetPlayerState(Player(dN),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(dN),PLAYER_STATE_RESOURCE_GOLD)+so)set ZV[gV[dN]]=ZV[gV[dN]]+Qocall eR(dN,2,I2S(ZV[gV[dN]]))endifset ZV[gV[ON]]=ZV[gV[ON]]+qocall SetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD)+so)set ZV[gV[cN]]=ZV[gV[cN]]-1call eR(cN,2,I2S(ZV[gV[cN]]))set i=0loopexitwhen i>$Bif fV[i]and gV[i]==gV[cN]thencall eR(i,2,I2S(ZV[gV[cN]]))endifset i=i+1endloopset i=0loopexitwhen i>$Bif fV[i]and gV[i]==gV[ON]thencall eR(i,2,I2S(ZV[gV[ON]]))endifset i=i+1endloopif gV[ON]!=gV[dN]thenset i=0loopexitwhen i>$Bif fV[i]and gV[i]==gV[dN]thencall eR(i,2,I2S(ZV[gV[dN]]))endifset i=i+1endloopendifendifcall zX(ss+s)call ShowUnit(AV[cN],false)call kR(bV[cN])if not YE thencall XN(ON)endifcall OI(function NN,Yo,0,(cN),'DMRE',0,0,0)elseif xV==3 thenif dV[cN]==$C thencall kR(bV[cN])if cN==ZE thenset dV[cN]=lA()elseset dV[cN]=ZEendifendifset i=0if cN==ZE thenset ir=1set s=s+"- 化身者被击杀了! "call SetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD)+so)call zX(ss+s)set iX[ZE]=0call ShowUnit(AV[cN],false)call kR(bV[cN])call ExecuteFunc("gN")elseset ir=2call SetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD)+so)call ShowUnit(AV[cN],false)call kR(bV[cN])call zX(ss+s)if aE<=1 thencall ExecuteFunc("gN")endifendifelseif xV==4 thenset i=0loopexitwhen i>$Bif fV[i]thenset fN=wV[cN*$C+i]if fN>DN thenset DN=fNset dN=iendifendifset i=i+1endloopif dN!=ON thenset ss=ss+" ("+FV[dN]+"|r)"call SA(dN,1)endifset i=0if cN==aX[gV[cN]]thenset s=s+"- 一个 |cffdaa520国王|r 被击杀了! "call zX(ss+s)call SetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(ON),PLAYER_STATE_RESOURCE_GOLD)+so)if DN>0 and dN!=$C thencall SetPlayerState(Player(dN),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(dN),PLAYER_STATE_RESOURCE_GOLD)+so)call uA(gV[cN],gV[ON],WA,yA)endifcall ShowUnit(AV[cN],false)call kR(bV[cN])call xN()elsecall ShowUnit(AV[cN],false)call kR(bV[cN])call zX(ss+s)call xN()endifendifcall sA(cN,1)call QA(ON,1)call eR(ON,1,I2S((BV[3*(ON)])))call ShowUnit(AV[cN],false)call kR(bV[cN])call eR(cN,0,XO(cN)+"|r")if CN thencall StartSound(Vr)endifif not XE or(xV==2 or xV==5)thencall gI(cN)endifendfunctionfunction GN takes integer hN,integer MA,real DO,real xx,real yy returns nothinglocal integer HN=bv[hN]local integer zA=bv[MA]local real eNif(Jv[MA]or Kv[MA])thencall nA(MA,HN,DO*lV[HN])returnendifif Nv[MA]==1 thenset nr=CreateTextTag()call SetTextTagPos(nr,U[MA],W[MA],0)call SetTextTagPermanent(nr,false)call SetTextTagLifespan(nr,1.2)call SetTextTagVelocity(nr,xx,yy)call SetTextTagFadepoint(nr,.6)if yr[MA]and zr[MA]>0 thenset DO=mA(MA,DO)endifset DO=DO*lV[HN]*LV[zA]call SetTextTagText(nr,KO(DO),.007*SquareRoot(DO+3.5))set eN=JV[zA]-DOif XE or jV[zA]thencall SetTextTagColor(nr,0,$E6,$E6,$FA)elsecall SetTextTagColor(nr,$E6,$D2,0,$FA)set cV[HN]=cV[HN]+DOset wV[zA*$C+HN]=wV[zA*$C+HN]+DOcall eR(HN,3,I2S(R2I(cV[HN])))set dV[zA]=HNif eN<.5 thenif vi[MA]==0 thencall BN(zA)elsecall oI(vi[MA])endifelseset JV[zA]=eNcall SetUnitState(M[MA],UNIT_STATE_LIFE,JV[zA])call NO(zA,DO)endifif Oi[HN]>0 and DV[HN]thencall qO(hN,DO*.1*Oi[HN]*qV[zA])endifendifendifendfunctionfunction jN takes integer hN,integer MA,real DO,real xx,real yy returns reallocal integer HN=bv[hN]local integer zA=bv[MA]local real eNset nr=CreateTextTag()call SetTextTagPos(nr,U[MA],W[MA],0)call SetTextTagPermanent(nr,false)call SetTextTagLifespan(nr,1.2)call SetTextTagVelocity(nr,xx,yy)call SetTextTagFadepoint(nr,.6)if yr[MA]and zr[MA]>0 thenset DO=mA(MA,DO)endifset DO=DO*lV[HN]*LV[zA]call SetTextTagText(nr,KO(DO),.007*SquareRoot(DO+3.5))set eN=JV[zA]-DOif XE or jV[zA]thencall SetTextTagColor(nr,0,$E6,$E6,$FA)elsecall SetTextTagColor(nr,$E6,$D2,0,$FA)set cV[HN]=cV[HN]+DOset wV[zA*$C+HN]=wV[zA*$C+HN]+DOcall eR(HN,3,I2S(R2I(cV[HN])))set dV[zA]=HNif eN<.5 thenif vi[MA]==0 thencall BN(zA)elsecall oI(vi[MA])endifelseset JV[zA]=eNcall SetUnitState(M[MA],UNIT_STATE_LIFE,JV[zA])call NO(zA,DO)endifif Oi[HN]>0 thenreturn DO*.1*Oi[HN]*qV[zA]endifendifreturn .0endfunctionfunction JN takes real dx,real dy,integer cO,real kN returns nothinglocal integer id=bv[cO]local real KN=.7*SquareRoot(kN-20)local real lN=Lv[br]local integer HN=dV[id]local integer hN=bV[HN]local boolean LN=lN-KN<=0local real URcall KillUnit(CreateUnit(Player($C),'pilx',U[cO]-dv[cO]*dx,W[cO]-dv[cO]*dy,bj_RADTODEG*Atan2(-dy,-dx)))if LN thenset Dv[hN]=Dv[hN]+Nr[id]endifcall nA(br,HN,KN)if LN thenset lN=.2-.3*Lv[br]/(lN-Lv[br])set Z[cO]=Z[cO]*lNset vv[cO]=vv[cO]*lNcall GN(hN,cO,KN+5,0,0)call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",M[cO],"chest"))elseset UR=kN*(1+Xv[Br])set Z[Br]=Z[Br]-UR*dxset vv[Br]=vv[Br]-UR*dycall GN(hN,cO,KN,0,0)endifendfunctionfunction mN takes integer CR,integer DR,real kN,boolean HO returns nothinglocal integer MN=bv[CR]local integer mO=bv[DR]local integer pNif HO thenset pN=dV[MN]elseset pN=dV[mO]endifif gV[MN]!=gV[pN]thencall GN(bV[pN],CR,.7*SquareRoot(kN-20),0,0)endifif gV[mO]!=gV[pN]thencall GN(bV[pN],DR,.7*SquareRoot(kN-20),0,0)endifcall DestroyEffect(AddSpecialEffect(UV[pN],(U[CR]+U[DR])/ 2,(W[CR]+W[DR])/ 2))endfunctionfunction PN takes integer hN,integer MA,real DO,real qN returns nothinglocal integer HN=bv[hN]local integer zA=bv[MA]local real dxlocal real dylocal real URlocal real QNset UR=SquareRoot(Z[hN]*Z[hN]+vv[hN]*vv[hN])if Kv[MA]thenset DO=DO-KV[HN]if DO<=0 thenreturnendifset QN='d'*DO*qN*.03if Ax[MA]==985 thenset QN=QN*.8elseif Ax[MA]==954 thenset QN=QN*.4endifset Z[MA]=Z[MA]+Z[hN]*QN/ URset vv[MA]=vv[MA]+vv[hN]*QN/ URcall GN(hN,MA,DO,.002*Z[hN],.002*vv[hN])elseif Jv[MA]thencall GN(hN,MA,DO-KV[HN],.002*Z[hN],.002*vv[hN])elseset DO=DO-KV[zA]-KV[HN]if DO<=0 thenreturnendifset QN=('d'+kV[zA])*DO*lV[HN]*LV[zA]*.03*mV[zA]*qNset Z[MA]=Z[MA]+Z[hN]*QN/ URset vv[MA]=vv[MA]+vv[hN]*QN/ URcall GN(hN,MA,DO,.002*Z[hN],.002*vv[hN])endifendfunctionfunction sN takes integer hN,integer MA,real DO,real qN returns nothinglocal integer HN=bv[hN]local integer zA=bv[MA]local real dxlocal real dylocal real URlocal real QNset dx=U[MA]-U[hN]set dy=W[MA]-W[hN]set UR=SquareRoot(dx*dx+dy*dy)if UR==0 thenset UR=1endifif Kv[MA]thenset DO=DO-KV[HN]if DO<=0 thenreturnendifset QN='d'*DO*qN*.03if Ax[MA]==985 thenset QN=QN*.8elseif Ax[MA]==954 thenset QN=QN*.4endifset dx=dx/ URset dy=dy/ URset Z[MA]=Z[MA]+QN*dxset vv[MA]=vv[MA]+QN*dycall GN(hN,MA,DO,.05*dx,.05*dy)elseif Jv[MA]thencall GN(hN,MA,DO-KV[HN],.05*dx,.05*dy)elseset DO=DO-KV[zA]-KV[HN]if DO<=0 thenreturnendifset QN=('d'+kV[zA])*DO*lV[HN]*LV[zA]*.03*mV[zA]*qNset dx=dx/ URset dy=dy/ URset Z[MA]=Z[MA]+QN*dxset vv[MA]=vv[MA]+QN*dycall GN(hN,MA,DO,.05*dx,.05*dy)endifendfunctionfunction SN takes real x,real y,integer hN,integer MA,real DO,real qN returns reallocal integer HN=bv[hN]local integer zA=bv[MA]local real dxlocal real dylocal real URlocal real QNset dx=U[MA]-xset dy=W[MA]-yset UR=SquareRoot(dx*dx+dy*dy)if UR==0 thenset UR=1endifif Kv[MA]thenset DO=DO-KV[HN]if DO<=0 thenreturn 0endifset QN='d'*DO*qN*.03if Ax[MA]==985 thenset QN=QN*.8elseif Ax[MA]==954 thenset QN=QN*.4endifset dx=dx/ URset dy=dy/ URset Z[MA]=Z[MA]+QN*dxset vv[MA]=vv[MA]+QN*dycall GN(hN,MA,DO,.05*dx,.05*dy)elseif Jv[MA]thencall GN(hN,MA,DO-KV[HN],.05*dx,.05*dy)elseset DO=DO-KV[zA]-KV[HN]if DO<=0 thenreturn 0endifset QN=('d'+kV[zA])*DO*lV[HN]*LV[zA]*.03*mV[zA]*qNset dx=dx/ URset dy=dy/ URset Z[MA]=Z[MA]+QN*dxset vv[MA]=vv[MA]+QN*dyreturn jN(hN,MA,DO,.05*dx,.05*dy)endifreturn .0endfunctionfunction tN takes integer hN,integer MA,real DO,real qN returns nothinglocal integer HN=bv[hN]local integer zA=bv[MA]local real dxlocal real dylocal real URlocal real QNset dx=U[MA]-U[hN]set dy=W[MA]-W[hN]set UR=SquareRoot(dx*dx+dy*dy)if UR==0 thenset UR=1endifset QN=('d'+kV[zA])*DO*lV[HN]*LV[zA]*.03*mV[zA]*qNset dx=dx/ URset dy=dy/ URset Z[MA]=Z[MA]+QN*dxset vv[MA]=vv[MA]+QN*dyendfunctionfunction TN takes integer hN,real DO,real uN,real x,real y,real UN,real wN returns nothinglocal integer id=bv[hN]local integer cOlocal integer nlocal real URlocal integer NA=gV[id]set id=$Bloopexitwhen id<0set cO=bV[id]if id!=bv[hN]and gV[id]!=NA and DV[id]thenif Dv[hN]>=Nr[id]thenset Dv[hN]=Dv[hN]-Nr[id]elseset UR=bR(U[cO],W[cO],x,y)if UR<=UN thenset UR=1-UR/ UNcall sN(hN,cO,DO*(wN+(1-wN)*UR),uN)endifendifendifset id=id-1endloopset Dv[hN]=0endfunctionfunction WN takes integer yN,real x,real y,real UN,real IO returns nothinglocal integer cOlocal integer nlocal real URlocal integer hNlocal integer NAlocal real dxlocal real dylocal real kNlocal integer id=$Bset hN=bV[yN]set NA=gV[yN]loopexitwhen id<0set cO=bV[id]if DV[id]thenif Dv[hN]>=Nr[id]thenset Dv[hN]=Dv[hN]-Nr[id]elseset dx=U[cO]-xset dy=W[cO]-yset UR=SquareRoot(dx*dx+dy*dy)set dx=dx/ URset dy=dy/ URif UR<=UN thenset UR=(1-UR/ UN/ 2)*IOset Z[cO]=Z[cO]+dx*UR*1.6set vv[cO]=vv[cO]+dy*UR*1.6if gV[id]==NA thencall qA(id,UR)elsecall GN(hN,cO,UR/ lV[yN],0,0)endifendifendifendifset id=id-1endloopset Dv[hN]=0endfunctionfunction YN takes integer hN,real DO,real uN,real UN returns nothinglocal integer id=bv[hN]local integer cO=svlocal integer nlocal real URlocal real x=U[hN]local real y=W[hN]local integer NA=gV[bv[hN]]local real wN=.5loopexitwhen cO==0set n=Rv[cO]set id=bv[cO]if gV[id]!=NA thenif Dv[hN]>=Nr[id]thenset Dv[hN]=Dv[hN]-Nr[id]elseset UR=bR(U[cO],W[cO],x,y)if UR<=UN thenset UR=1-UR/ UNcall sN(hN,cO,DO*(wN+(1-wN)*UR),uN)endifendifendifset cO=nendloopset Dv[hN]=0endfunctionfunction zN takes real x,real y,integer NA returns integerlocal integer cO=svlocal integer ZN=0local real vb=$5F5E0FFlocal real URloopexitwhen cO==0if gV[bv[cO]]!=NA thenset UR=BR(U[cO],W[cO],x,y)if UR<vb thenset ZN=cOset vb=URendifendifset cO=Rv[cO]endloopreturn ZNendfunctionfunction eb takes integer hN,real DO,real uN,real UN returns booleanlocal integer id=bv[hN]local integer cO=svlocal integer nlocal real URlocal real x=U[hN]local real y=W[hN]local integer NA=gV[bv[hN]]local real wN=.5local boolean xb=falseloopexitwhen cO==0set n=Rv[cO]set id=bv[cO]if gV[id]!=NA thenif Dv[hN]>=Nr[id]thenset Dv[hN]=Dv[hN]-Nr[id]elseset UR=bR(U[cO],W[cO],x,y)if UR<=UN thenset UR=1-UR/ UNset xb=truecall sN(hN,cO,DO*(wN+(1-wN)*UR),uN)endifendifendifset cO=nendloopset Dv[hN]=0return xbendfunctionfunction ob takes real rb,real ib,real ab,real nb,integer HN,real kN returns nothinglocal integer cO=svlocal real Vb=ab-rblocal real Eb=nb-iblocal real Xb=SquareRoot(Vb*Vb+Eb*Eb)local integer aI=0local real H=0local real URset Vb=Vb/ Xbset Eb=Eb/ Xbloopexitwhen cO==0set aI=Rv[cO]if gV[bv[cO]]!=gV[HN]thenif(RAbsBJ((U[cO]-rb)*(-Eb)+(W[cO]-ib)*(Vb))<Sr)thenset UR=((U[cO]-rb)*(Vb)+(W[cO]-ib)*(Eb))if(UR>0 and UR<Xb)thenset H=H+jN(bV[HN],cO,kN,0,0)call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\VengeanceMissile\\VengeanceMissile.mdl",M[cO],"chest"))endifendifendifset cO=aIendloopif DV[HN]and H>.001 thencall qO(bV[HN],H)endifendfunctionfunction Ob takes string s returns nothingcall DisplayTimedTextToPlayer(Player(0),0,0,'d',YR()+"|c00FF0000[BUFFS] "+s+"|r")endfunctionfunction Rb takes nothing returns integerlocal integer id=Seset Se=qe[id]set qe[id]=seset Qe[id]=0if se!=0 thenset Qe[se]=idendifset se=idreturn idendfunctionfunction Ib takes integer Ab,integer cO,integer Nb returns integerlocal integer bf=selocal integer aI=0loopexitwhen bf==0set aI=qe[bf]if Ab==Ue[bf]and ue[bf]==cO and We[bf]==Nb thenreturn bfendifset bf=aIendloopreturn 0endfunctionfunction bb takes integer bf,real DO,boolean Bb returns nothinglocal real msset ms=Lv[ue[bf]]-DOif ms<0 and Bb thenset DO=DO+msset ms=0endifset Ye[bf]=DOset Lv[ue[bf]]=msendfunctionfunction cb takes integer bf,real vO returns nothingif Te[bf]thenset te[bf]=vOelsecall Ob("不支持修改外部定时BUFF的时间 (buff "+I2S(bf)+")")endifendfunctionfunction Cb takes integer Ab,integer db,integer ZN,real kN,real vO returns integerlocal integer bf=Rb()set Ue[bf]=Abset ue[bf]=ZNset We[bf]=bv[db]set ye[bf]=kN/ vO*.25set te[bf]=vOset Te[bf]=truereturn bfendfunctionfunction Db takes integer bf,integer fb,effect ef returns nothingif fb>=1 and fb<=3 thenset we[3*bf+fb-1]=efelsecall Ob("[Buff_SetEffect])中存在错误的效果位置 ("+I2S(fb)+")")endifendfunctionfunction Fb takes nothing returns nothinglocal integer bf=selocal integer aI=0loopexitwhen bf==0set aI=qe[bf]if ye[bf]>0 thencall GN(bV[We[bf]],ue[bf],ye[bf],0,0)endifif Te[bf]thenset te[bf]=te[bf]-.25if te[bf]<0 thencall CA(bf)endifendifset bf=aIendloopendfunctionfunction gb takes nothing returns nothingif Kr[ae]thenset lr[ae]=falseset Kr[ae]=falseif not Mr[ae]thenset Mv[ae]=nullendifset dv[ae]=dv[ae]-Kocall UnitRemoveAbility(M[ae],'Agho')call JA(ae,KA(ae)-Jr/ 3.)call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl",U[br],W[br]))endifendfunctionfunction Gb takes real vx,real vy returns realreturn vx*vx+vy*vyendfunctionfunction hb takes nothing returns nothingif Kr[ae]thenset lr[ae]=trueendifendfunctionfunction GA takes nothing returns nothingif kr[ae]thenset kr[ae]=falseif not Mr[ae]thenset Mv[ae]=nullendifset dv[ae]=dv[ae]-Kocall UnitRemoveAbility(M[ae],'Agho')call JA(ae,KA(ae)-Jr)call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl",U[ae],W[ae]))endifendfunctionfunction Hb takes nothing returns nothingcall iI(true,br,true,$539,true,be)call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl",U[br],W[br]))endfunctionfunction gA takes nothing returns nothingif Mr[br]thenset Mr[br]=falseset Ev[br]=0if not kr[br]and not Kr[br]thenset Mv[br]=nullendifset dv[br]=dv[br]-loset Z[br]=.2*Z[br]set vv[br]=.2*vv[br]set xv[br]=0set ov[br]=0set iv[br]=0set av[br]=0call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathMissile.mdl",U[br],W[br]))endifendfunctionfunction jb takes nothing returns nothingset Mr[br]=falseset Ev[br]=0if not kr[br]and not Kr[br]thenset Mv[br]=nullendifset dv[br]=dv[br]-loset Z[br]=0set vv[br]=0set xv[br]=0set ov[br]=0set iv[br]=0set av[br]=0call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",U[br],W[br]))endfunctionfunction Jb takes nothing returns nothingset Mr[br]=falseset Ev[br]=0if not kr[br]and not Kr[br]thenset Mv[br]=nullendifset dv[br]=dv[br]-loset Z[br]=0set vv[br]=0set xv[br]=0set ov[br]=0set Mr[Br]=falseset Ev[Br]=0if not kr[Br]and not Kr[Br]thenset Mv[Br]=nullendifset dv[Br]=dv[Br]-loset Z[Br]=0set vv[Br]=0set xv[Br]=0set ov[Br]=0call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",U[Br],W[Br]))call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",U[br],W[br]))endfunctionfunction kb takes nothing returns nothinglocal integer id=bv[br]set Er=CreateUnit(Player(id),TV[id],U[br],W[br],GetUnitFacing(M[br]))call SetUnitScale(Er,sV[id],sV[id],sV[id])call SetUnitTimeScale(Er,.1)call SetUnitVertexColor(Er,'d','d','d',50)call KillUnit(Er)endfunctionfunction Kb takes integer id returns nothinglocal integer lblocal integer Lb=WV[8*id+3]set lb=GetUnitAbilityLevel(AV[id],Lb)call UnitRemoveAbility(AV[id],Lb)call UnitAddAbility(AV[id],Lb)call SetUnitAbilityLevel(AV[id],Lb,lb)endfunctionfunction mb takes integer CR,integer DR returns nothinglocal integer id=bv[CR]local integer mO=bv[DR]call OI((function hb),((.5)*1.),(CR),(4312),(be),0,0,0)set Er=CreateUnit(Player(id),TV[id],U[CR],W[CR],GetUnitFacing(M[CR]))call SetUnitScale(Er,sV[id],sV[id],sV[id])call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Defend\\DefendCaster.mdl",AV[id],"origin"))call SetUnitVertexColor(Er,$FF,$FF,$FF,$96)call KillUnit(Er)if Mr[CR]thencall sN(CR,DR,5.+.4*ai[id],1)call jb()set Dr=falseelsecall tN(CR,DR,2.5,75/('d'+kV[id]))set Oi[id]=Oi[id]+$Acall GN(CR,DR,.5+.1*ri[id],0,0)set Oi[id]=Oi[id]-$Aendifcall tN(DR,CR,2.5,'d'/('d'+kV[mO]))if lv[CR]==DR thencall EA(CR)endifif lv[DR]==CR thencall EA(DR)endifendfunctionfunction Mb takes nothing returns booleanlocal integer act=0local real vOlocal integer id=bv[br]local integer mO=bv[Br]if Nv[Br]==1 and gV[id]!=gV[mO]thenif(Wr[Br]!=0)and Mr[br]thenreturn falseendifif(kr[br]and kr[Br])or(Mr[br]and Mr[Br])thencall DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Cyclone\\CycloneTarget.mdl",(U[br]+U[Br])/ 2.,(W[br]+W[Br])/ 2.))call StartSound(do)set nr=CreateTextTag()call SetTextTagPos(nr,(U[br]+U[Br])/ 2.,(W[br]+W[Br])/ 2.,0)call SetTextTagPermanent(nr,false)call SetTextTagColor(nr,$FF,$80,0,$DC)call SetTextTagText(nr,"旋风!",.027)call SetTextTagLifespan(nr,1.5)call SetTextTagFadepoint(nr,1.)call SetTextTagVelocity(nr,0,.055)endifif Kr[br]and(not Kr[Br])and lr[br]thencall mb(br,Br)if lv[Br]==br thencall EA(Br)endifif lv[br]==Br thencall EA(br)endifelseif kr[br]thenif Mr[br]thenif ur[Br]and not XE thenif GetLocalPlayer()==Player(id)or GetLocalPlayer()==Player(mO)thencall StartSound(go)set nr=CreateTextTag()call SetTextTagPos(nr,U[Br],W[Br],0)call SetTextTagPermanent(nr,false)call SetTextTagColor(nr,$FF,30,30,$DC)call SetTextTagText(nr,"锁定",.025)call SetTextTagLifespan(nr,1.5)call SetTextTagFadepoint(nr,1.)call SetTextTagVelocity(nr,0,.055)endifcall DestroyEffect(AddSpecialEffect(UV[mO],U[Br],W[Br]))call iI(true,Br,true,'en74',true,Ne)call Kb(id)endifset Cr=Gb(Z[br],vv[br])/(39*39)if Cr>.8 thenset Cr=5.+.4*ai[id]elseset Cr=Cr/ .8*(5.+.4*ai[id])endifset Cr=4.8+.6*ri[id]+Crcall sN(br,Br,Cr,.7)call Hb()call jb()set Dr=falseelsecall sN(br,Br,4.8+.6*ri[id],1)call Hb()set Dr=falseendifif lv[Br]==br thencall EA(Br)endifelseif Mr[br]thenif Mr[Br]thencall Jb()call sN(br,Br,5.+.4*ai[id],1.)call sN(Br,br,5.+.4*ai[bv[br]],1.)elseset Cr=Gb(Z[br],vv[br])/(39*39)if Cr>.8 thenset Cr=5.+.4*ai[id]elseset Cr=Cr/ .8*(5.+.4*ai[id])endifcall sN(br,Br,Cr,1.)call jb()endifif lv[Br]==br thencall EA(Br)endifif lv[br]==Br thencall EA(br)endifset Dr=falseendifendifreturn falseendfunctionfunction pb takes integer Pb returns nothingif not Cn thencall SetTerrainType(0,0,Hn[Bn],-1,ln+1-Mn,Mn)if Dn thencall SetTerrainType(Fn,gn,Hn[Bn],-1,hn+1-Mn,Mn)endifcall SetTerrainType(0,0,jn[Bn],0,Pb-Mn,Mn)if Dn thenif hn>0 thenif GetTerrainType(Fn,gn)==Hn[Bn]thenset hn=hn-1endifelseset Dn=falseendifcall SetTerrainType(Fn,gn,'Idki',0,hn-Gn,Gn)endifif fn thencall SetTerrainType(0,0,Hn[Bn],0,4-Mn,Mn)endifendifendfunctionfunction qb takes nothing returns nothinglocal integer cO=svlocal integer n=0local integer idlocal integer Qbloopexitwhen cO==0set n=Rv[cO]set Qb=GetTerrainType(U[cO],W[cO])if Qb==Hn[Bn]and not jV[bv[cO]]thenset pn[cO]=2set id=bv[cO]set JV[id]=JV[id]-vr[id]if JV[id]<.5 thenif vi[cO]==0 thenset mn[Ln]=idset Ln=Ln+1elsecall oI(vi[cO])endifelseif not Zr[cO]thencall DestroyEffect(AddSpecialEffect(Jn[Bn],U[cO],W[cO]))endifcall SetUnitState(AV[id],UNIT_STATE_LIFE,JV[id])call NO(id,vr[id]/ 2.)if dV[id]!=$C and dV[id]!=id thenset wV[id*$C+dV[id]]=wV[id*$C+dV[id]]+vr[id]/ 2.endifendifelseif Qb=='Idki' thenset pn[cO]=3set id=bv[cO]call RO(id,CV[id]*QV[id])elseset id=bv[cO]call RO(id,CV[id]*QV[id])set pn[cO]=1endifset cO=nendloopif Ln>0 thenif Ln==1 thencall BN(mn[0])set Ln=0elseloopexitwhen(Ln==0)set n=0loopexitwhen(n==Ln)if JV[mn[n]]<JV[mn[id]]thenset id=nendifset n=n+1endloopcall BN(mn[id])set n=idloopexitwhen(n==Ln)set mn[n]=mn[n+1]set n=n+1endloopset Ln=Ln-1endloopendifendifendfunctionfunction sb takes nothing returns nothingif not Cn thenset ln=ln-1call pb(ln)if ln>0 thencall TimerStart(Kn,rr*SquareRoot(aE),false,function sb)call SetTimeOfDayScale($F0/(SquareRoot(aE)*rr))elsecall PauseTimer(Kn)endifendifendfunctionfunction Sb takes boolean tb returns nothingif tb thencall TimerStart(kn,.1,true,function qb)if Cn thenelseif xV==2 or xV==5 thenset ln=9+R2I(SquareRoot(rE))call pb(ln)elseif xV==1 or xV==3 or xV==4 thenset ln=9+R2I(SquareRoot(rE))call pb(ln)call TimerStart(Kn,rr*SquareRoot(aE),false,function sb)call SetFloatGameState(GAME_STATE_TIME_OF_DAY,6)call SetTimeOfDayScale($F0/(SquareRoot(aE)*rr))endifelsecall pb(ln)call PauseTimer(kn)if Cn thenelseif xV==5 thenelseif xV==2 thenelseif xV==1 or xV==3 or xV==4 thencall PauseTimer(Kn)call SetFloatGameState(GAME_STATE_TIME_OF_DAY,6)call SetTimeOfDayScale(0)set ln=9+rE/ 2endifendifendfunctionfunction Tb takes real x,real y returns integerreturn sx[HR(x-Sx)+65*HR(y-tx)]endfunctionfunction ub takes nothing returns nothinglocal integer cOlocal integer Ublocal integer intlocal real pxlocal real pylocal real pzlocal real vxlocal real vylocal real vzlocal real hxlocal real hylocal real rlocal real r2local real slocal boolean wb=falselocal boolean Wb=falselocal boolean bl3local boolean bl4set pe=pe+1if pe==3 thenset Me=trueset pe=0if me thenset Le=falseset me=falseelseset Le=trueset me=trueendifelseset Le=falseset Me=falseendifset cO=Qvloopexitwhen cO==0set Ub=Rv[cO]if cO==Ub thencall BJDebugMsg("|c00FF0000列表错误 "+I2S(cO)+" 请将录像报告官网")call lR(cO,false)endifif Nv[cO]==1 thenset r=0set br=cOif pn[cO]==3 thenif not ur[cO]thenset vx=GetUnitX(M[cO])-U[cO]set vy=GetUnitY(M[cO])-W[cO]if vx!=0 or vy!=0 thenset r=SquareRoot(vx*vx+vy*vy)endifif r!=0 thenset vx=vx/ rset vy=vy/ rset r=Z[cO]*vx+vv[cO]*vyif r<=Lv[cO]then