 OXreal AX=.0real NX=.0boolexpr cX=nullendglobalsfunction fX takes nothing returns booleanlocal real dx=GetDestructableX(GetFilterDestructable())-AXlocal real dy=GetDestructableY(GetFilterDestructable())-NXreturn(dx*dx+dy*dy<=bj_enumDestructableRadius)endfunctionfunction FX takes itemtype gX,integer GX returns nothinglocal group gset bj_stockPickedItemType=gXset bj_stockPickedItemLevel=GXset g=CreateGroup()call GroupEnumUnitsOfType(g,"marketplace",cX)call ForGroup(g,function UpdateEachStockBuildingEnum)call DestroyGroup(g)set g=nullendfunctionfunction hX takes nothing returns nothinglocal integer pickedItemIdlocal itemtype HXlocal integer jX=0local integer JX=0local integer GXset GX=1loopif(bj_stockAllowedPermanent[GX])thenset JX=JX+1if(GetRandomInt(1,JX)==1)thenset HX=ITEM_TYPE_PERMANENTset jX=GXendifendifif(bj_stockAllowedCharged[GX])thenset JX=JX+1if(GetRandomInt(1,JX)==1)thenset HX=ITEM_TYPE_CHARGEDset jX=GXendifendifif(bj_stockAllowedArtifact[GX])thenset JX=JX+1if(GetRandomInt(1,JX)==1)thenset HX=ITEM_TYPE_ARTIFACTset jX=GXendifendifset GX=GX+1exitwhen GX>$Aendloopif(JX==0)thenset HX=nullreturnendifcall FX(HX,jX)set HX=nullendfunctionfunction kX takes nothing returns nothingcall hX()call TimerStart(bj_stockUpdateTimer,bj_STOCK_RESTOCK_INTERVAL,true,function hX)endfunctionfunction lX takes nothing returns booleanreturn trueendfunctionfunction pX takes string s returns integerif StringCase(s,false)!=s thenreturn GetStoredInteger(o,"U",s)elsereturn GetStoredInteger(o,"L",s)endifendfunctionfunction TestChars takes nothing returns nothinglocal string PX=""local integer qX=0local string QX=""local integer sX=0local integer id=32loopexitwhen id>$7Eif pX((V[(id)]))!=id thenset PX=PX+(V[(id)])+" "set qX=qX+1elseset QX=QX+(V[(id)])+" "set sX=sX+1endifset id=id+1endloopcall DisplayTimedTextToPlayer(Player(0),0,0,'d',"错误 ("+I2S(qX)+"): "+PX)call DisplayTimedTextToPlayer(Player(0),0,0