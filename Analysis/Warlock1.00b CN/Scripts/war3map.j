 integer a returns integerif GetRandomInt(0,1)==1 thenreturn a*2elsereturn a*2+1endifendfunctionfunction fB takes nothing returns nothinglocal integer i=AB()loopexitwhen i==0call RemoveUnit(ix[i])call NB(i,GetRandomReal(0,360),ox[i],rx[i],DB(6))call ShowUnit(ix[i],false)set i=i-1endloopendfunctionfunction FB takes nothing returns nothinglocal integer gB=0local integer mX=0local real bB=GetRandomReal(-bj_PI,bj_PI)local integer ilocal integer jlocal real GBlocal real hBset Xx=Condition(function CB)set Hx=Condition(function vB)set jx=Condition(function nB)set Jx=Condition(function aB)set kx=Condition(function eB)set Kx=Condition(function IB)set gV[$C]=$Cset PV[$C]=1.loopexitwhen mX>50set Vx[mX]=0set mX=mX+1endloopset Ex=1set mX=0set i=GetRandomInt(0,4)if GetRandomInt(1,$3E8)>997 thenset i=5endifset mX=GetRandomInt(1,6)set j=GetRandomInt(1,6)set hB=SquareRoot(3)/ 2if mX!=1 and j!=1 thencall BB(0,700,DB(i),2,GetRandomReal(0,360))endifif mX!=2 and j!=2 thencall BB(0,-700,DB(i),2,GetRandomReal(0,360))endifif mX!=3 and j!=3 thencall BB(hB*700,350,DB(i),2,GetRandomReal(0,360))endifif mX!=4 and j!=4 thencall BB(-hB*700,350,DB(i),2,GetRandomReal(0,360))endifif mX!=5 and j!=5 thencall BB(hB*700,-350,DB(i),2,GetRandomReal(0,360))endifif mX!=6 and j!=6 thencall BB(-hB*700,-350,DB(i),2,GetRandomReal(0,360))endifset mX=0loopexitwhen mX>=$Cif GetPlayerSlotState(Player(mX))==PLAYER_SLOT_STATE_PLAYING thenset gB=gB+1endifset mX=mX+1endloopset mX=1set GB=768+64*gBset i=GetRandomInt(0,4)if GetRandomInt(1,$3E8)>997 thenset i=5endifloopexitwhen mX>4set mX=mX+1set hB=GetRandomReal(0,GB*GB)set hB=SquareRoot(hB)set bB=GetRandomReal(-bj_PI,bj_PI)call BB(Cos(bB)*hB,Sin(bB)*hB,DB(i),3,GetRandomReal(0,360))endloopset i=GetRandomInt(0,4)if GetRandomInt(1,$3E8)>997 thenset i=5endifcall BB(896/ 1.5,896/ 1.5,DB(i),4,GetRandomReal(0,360))call BB(-896/ 1.5,-896/ 1.5,DB(i),4,GetRandomReal(0,360))call BB(896/ 1.5,-896/ 1.5,DB(i),4,GetRandomReal(0,360))call BB(-896/ 1.5,896/ 1.5,DB(i),4,GetRandomReal(0,360))set i=GetRandomInt(0,4)if GetRandomInt(1,$3E8)>997 thenset i=5endifcall BB(896,0,DB(i),5,GetRandomReal(0,360))call BB(-896,0,DB(i),5,GetRandomReal(0,360))call BB(0,-896,DB(i),5,GetRandomReal(0,360))call BB(0,896,DB(i),5,GetRandomReal(0,360))set i=GetRandomInt(0,4)if GetRandomInt(1,$3E8)>997 thenset i=5endifset bB=GetRandomReal(-bj_PI,bj_PI)call BB(400*Cos(bB),400*Cos(bB),DB(i),6,GetRandomReal(0,360))set bB=GetRandomReal(-bj_PI,bj_PI)call BB(600*Cos(bB),600*Sin(bB),DB(i),6,GetRandomReal(0,360))set i=GetRandomInt(0,4)if GetRandomInt(1,$3E8)>997 thenset i=5endifcall BB(300*Cos(bB),300*Sin(bB),DB(i),7,GetRandomReal(0,360))call BB(300*Cos(bB+bj_PI),300*Sin(bB+bj_PI),DB(i),7,GetRandomReal(0,360))set bB=GetRandomReal(-bj_PI,bj_PI)set i=GetRandomInt(0,4)if GetRandomInt(1,$3E8)>997 thenset i=5endifcall BB(400*Cos(bB),400*Sin(bB),DB(i),8,GetRandomReal(0,360))call BB(400*Cos(bB+2*bj_PI/ 3),400*Sin(bB+2*bj_PI/ 3),DB(i),8,GetRandomReal(0,360))call BB(400*Cos(bB-2*bj_PI/ 3),400*Sin(bB-2*bj_PI/ 3),DB(i),8,GetRandomReal(0,360))set bB=GetRandomReal(-bj_PI,bj_PI)set i=GetRandomInt(0,4)if GetRandomInt(1,$3E8)>997 thenset i=5endifcall BB(550*Cos(bB+.3),550*Sin(bB+.3),DB(i),9,GetRandomReal(0,360))call BB(550*Cos(bB-.3),550*Sin(bB-.3),DB(i),9,GetRandomReal(0,360))set bB=bB+bj_PIcall BB(550*Cos(bB+.3),550*Sin(bB+.3),DB(i),9,GetRandomReal(0,360))call BB(550*Cos(bB-.3),550*Sin(bB-.3),DB(i),9,GetRandomReal(0,360))set i=GetRandomInt(0,4)if GetRandomInt(1,$3E8)>997 thenset i=5endifset bB=GetRandomReal(-bj_PI,bj_PI)call BB(700*Cos(bB),700*Sin(bB),DB(i),$A,GetRandomReal(0,360))set bB=GetRandomReal(-bj_PI,bj_PI)call BB(700*Cos(bB),700*Sin(bB),DB(i),$A,GetRandomReal(0,360))set bB=GetRandomReal(-bj_PI,bj_PI)set i=GetRandomInt(0,4)if GetRandomInt(1,$3E8)>997 thenset i=5endifset GB=GetRandomReal(-300,300)call BB(700*Cos(bB)+GB,700*Sin(bB)+GB,DB(i),$B,GetRandomReal(0,360))call BB(700*Cos(bB+bj_PI)+GB,700*Sin(bB+bj_PI)+GB,DB(i),$B,GetRandomReal(0,360))call BB(GB,GB,DB(i),$B,GetRandomReal(0,360))endfunctionfunction HB takes real x,real y returns nothingset WE[yE*2]=xset WE[yE*2+1]=yset yE=yE+1endfunctionfunction jB takes string JB returns nothingset Bn=S2I(SubString(JB,0,1))set cn=trueif Bn<=0 or Bn>5 thenset Bn=GetRandomInt(1,5)endifset mx=S2I(SubString(JB,1,2))if mx<=0 or mx>Ox thenset mx=GetRandomInt(1,Ox)endifcall SetTerrainType(0,0,Hn[Bn],-1,'d',1)set Mx=0set Px=0endfunctionfunction kB takes integer x,integer y returns nothinglocal integer DO=sx[x+y*65]set qx=x*$80+Sxset Qx=y*$80+txif(DO==1 or DO==3)thencall BB(qx,Qx,GetRandomInt(0,1)+2*(mx-1),1,GetRandomReal(0,360))endifif(DO==2 or DO==3 or DO==4 or DO==6)thencall SetTerrainType(qx,Qx,jn[Bn],-1,1,0)endifif(DO==4)thencall HB(qx,Qx)elseif(DO==5)thencall SetTerrainType(qx,Qx,'Idki',-1,1,0)elseif(DO==6)thencall TerrainDeformCrater(qx,Qx,64,-Lx,1,true)endifendfunctionfunction KB takes integer DO returns nothingset sx[Mx+Px*65]=DOif Mx<65 and Px<65 thencall kB(Mx,Px)endifset Mx=Mx+1if(Mx>=65)thenset Mx=0set Px=Px+1endifendfunctionfunction lB takes string LB returns nothinglocal integer mB=0local integer Xb=StringLength(LB)-2local integer MB=0set LB=SubString(LB,2,Xb+2)set Cn=trueloopexitwhen mB>=Xbset MB=pX(SubString(LB,mB,mB+1))-32call KB(MB/ $A)call KB(ModuloInteger(MB,$A))set mB=mB+1endloopset Uo=1endfunctionfunction CTConversion_ApplyTerrain takes nothing returns nothingcall xO("call to CTC->-ApplyTerrain")endfunctionfunction pB takes string s returns integerlocal integer i=S2I(s)if StringLength(s)>1 thenreturn 0endifif i>0 thenreturn ielseif s=="A" or s=="a" thenreturn $Aelseif s=="B" or s=="b" thenreturn $Belseif s=="C" or s=="c" thenreturn $Celseif s=="D" or s=="d" thenreturn $Delseif s=="E" or s=="e" thenreturn $Eelseif s=="F" or s=="f" thenreturn $Felsereturn 0endifendfunctionfunction PB takes integer r,integer g,integer b returns stringlocal string QX="0123456789ABCDEF"return"|cff"+SubString(QX,R2I(r/ 16),R2I(r/ 16)+1)+SubString(QX,ModuloInteger(r,16),ModuloInteger(r,16)+1)+SubString(QX,R2I(g/ 16),R2I(g/ 16)+1)+SubString(QX,ModuloInteger(g,16),ModuloInteger(g,16)+1)+SubString(QX,R2I(b/ 16),R2I(b/ 16)+1)+SubString(QX,ModuloInteger(b,16),ModuloInteger(b,16)+1)endfunctionfunction qB takes string s returns integerlocal integer lO=StringLength(s)local integer i=lOlocal integer kA=0loopexitwhen i<=0set kA=kA+R2I(pB(SubString(s,i-1,i))*Pow(16,(lO-i)))set i=i-1endloopset s=""return kAendfunctionfunction QB takes nothing returns nothingif AE thencall DisplayTextToPlayer(GetTriggerPlayer(),0,0,I2S(qB(SubString(GetEventPlayerChatString(),2,20))))endifendfunctionfunction sB takes nothing returns nothinglocal integer i=0if AE thencall ZX("|cAFFFFFFFFid-red-green-blue|r",60)loopexitwhen i>$Bcall ZX(I2S(i)+"---|c00FF0000"+I2S((qB(SubString((yV[i]),4,6))))+"|r-|c0000FF00"+I2S((qB(SubString((yV[i]),6,8))))+"|r-|c000000FF"+I2S((qB(SubString((yV[i]),8,$A))))+"|r",60)set i=i+1endloopendifendfunctionfunction SB takes nothing returns nothinglocal trigger t=CreateTrigger()call TriggerRegisterPlayerChatEvent(t,Player(0),"6x",false)call TriggerAddAction(t,function QB)set t=CreateTrigger()call TriggerRegisterPlayerChatEvent(t,Player(0),"-list colors",true)call TriggerAddAction(t,function sB)set t=nullset Tx[0]="0"set Tx[1]="1"set Tx[2]="2"set Tx[3]="3"set Tx[4]="4"set Tx[5]="5"set Tx[6]="6"set Tx[7]="7"set Tx[8]="8"set Tx[9]="9"set Tx[$A]="A"set Tx[$B]="B"set Tx[$C]="C"set Tx[$D]="D"set Tx[$E]="E"set Tx[$F]="F"endfunctionfunction tB takes nothing returns nothinglocal integer i=1set Nr[0]=1loopexitwhen i>$Bset Nr[i]=2*Nr[i-1]set i=i+1endloopset fr=GetRectMinX(bj_mapInitialPlayableArea)set gr=GetRectMaxX(bj_mapInitialPlayableArea)set Fr=GetRectMinY(bj_mapInitialPlayableArea)set Gr=GetRectMaxY(bj_mapInitialPlayableArea)endfunctionfunction TB takes nothing returns nothingreturncall CreateQuestBJ(0,"3.14159","IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII","ReplaceableTextures\\CommandButtons\\BTNHolyBolt.blp")endfunctionfunction uB takes nothing returns nothinglocal integer id=bv[ae]if ne==1 thenset MV[id]=MV[id]-.08set Ii[id]=Ii[id]-1elseif ne==2 thenset MV[id]=MV[id]-.08set Ii[id]=Ii[id]-1set Ri[id]=Ri[id]-1elseif ne==3 thenset MV[id]=MV[id]-.08set Ii[id]=Ii[id]-1set Ri[id]=Ri[id]-1set Oi[id]=Oi[id]-1elseif ne==4 thenset MV[id]=MV[id]-2*.08set Ii[id]=Ii[id]-2set Ri[id]=Ri[id]-1set Oi[id]=Oi[id]-1elseif ne==5 thenset MV[id]=MV[id]-2*.08set Ii[id]=Ii[id]-2set Ri[id]=Ri[id]-2set Oi[id]=Oi[id]-1elseif ne==6 thenset MV[id]=MV[id]-2*.08set Ii[id]=Ii[id]-2set Ri[id]=Ri[id]-2set Oi[id]=Oi[id]-2elseif ne==7 thenset MV[id]=MV[id]-3*.08set Ii[id]=Ii[id]-3set Ri[id]=Ri[id]-2set Oi[id]=Oi[id]-2elseif ne==8 thenset MV[id]=MV[id]-3*.08set Ii[id]=Ii[id]-3set Ri[id]=Ri[id]-3set Oi[id]=Oi[id]-2endifendfunctionfunction UB takes integer cO,integer id returns nothingif Vi[id]==1 thenset MV[id]=MV[id]+1*.08set Ii[id]=Ii[id]+1elseif Vi[id]==2 thenset MV[id]=MV[id]+1*.08set Ii[id]=Ii[id]+1set Ri[id]=Ri[id]+1elseif Vi[id]==3 thenset MV[id]=MV[id]+1*.08set Ii[id]=Ii[id]+1set Ri[id]=Ri[id]+1set Oi[id]=Oi[id]+1elseif Vi[id]==4 thenset MV[id]=MV[id]+2*.08set Ii[id]=Ii[id]+2set Ri[id]=Ri[id]+1set Oi[id]=Oi[id]+1elseif Vi[id]==5 thenset MV[id]=MV[id]+2*.08set Ii[id]=Ii[id]+2set Ri[id]=Ri[id]+2set Oi[id]=Oi[id]+1elseif Vi[id]==6 thenset MV[id]=MV[id]+2*.08set Ii[id]=Ii[id]+2set Ri[id]=Ri[id]+2set Oi[id]=Oi[id]+2elseif Vi[id]==7 thenset MV[id]=MV[id]+3*.08set Ii[id]=Ii[id]+3set Ri[id]=Ri[id]+2set Oi[id]=Oi[id]+2elseif Vi[id]==8 thenset MV[id]=MV[id]+3*.08set Ii[id]=Ii[id]+3set Ri[id]=Ri[id]+3set Oi[id]=Oi[id]+2endifcall OI((function uB),((2.*MV[id])*1.),(bi),(Vi[id]),(be),0,0,0)endfunctionfunction wB takes nothing returns nothingcall DestroyEffect(Re)endfunctionfunction WB takes nothing returns nothinglocal integer id=bv[ae]local integer mX=0local boolean yB=falsecall SetPlayerAbilityAvailable(Player(id),ne,true)loopif WV[8*id+mX]==ne thenset yB=trueelseset mX=mX+1endifif(mX==8)thencall BJDebugMsg("沉默: 严重溢出"+I2S(mX))endifexitwhen yBendloopcall SetPlayerAbilityAvailable(Player(id),'W000'+mX,false)set wr[8*id+mX]=falseendfunctionfunction YB takes integer zB,integer ZB,integer vc,real vO returns reallocal integer ec=WV[vc*8+ZB]if wr[ZB+8*vc]thencall iI(true,bV[vc],true,ec,true,Ne)endifcall SetPlayerAbilityAvailable(Player(vc),ec,false)call SetPlayerAbilityAvailable(Player(vc),zB,true)set wr[ZB+8*vc]=truecall OI((function WB),((vO)*1.),(bV[vc]),(ec),(Ne),0,0,0)return vOendfunctionfunction xc takes string VR,integer r,integer g,integer b,integer YO,real Pb,real x,real y,sound oc,real PO,real rc,real uR returns nothingif oc!=null thencall StartSound(oc)set oc=nullendifset nr=CreateTextTag()call SetTextTagPos(nr,x,y,0)call SetTextTagPermanent(nr,false)call SetTe