(U[cO],W[cO],TX,TY)if UR<vb thenset ZN=cOset vb=URendifendifset cO=Rv[cO]endloopif ZN!=0 thenset lv[vN]=ZNset Pv[vN]=Mielseset Pv[vN]=miendifendfunctionfunction xC takes nothing returns booleanset xv[br]=0set ov[br]=0set Pv[br]=Kiset Ev[br]=0set mv[br]=nullreturn falseendfunctionfunction oC takes nothing returns booleanlocal real dx=U[Br]-U[br]local real dy=W[Br]-W[br]local real URlocal real rClocal real uN=.95local real kN=6.3+.7*cv[br]call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\BallistaMissile\\BallistaImpact.mdl",U[br],W[br]))if Nv[Br]==1 and Wr[Br]==0 thencall DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",U[Br],W[Br]))call sN(br,Br,kN*(1+.1*lv[br]),uN*(1/(1+.1*lv[br])))set lv[br]=lv[br]+1set UR=SquareRoot(dx*dx+dy*dy)set dx=dx/ URset dy=dy/ URset rC=500set Z[br]=-rC*dx/ 'd'set vv[br]=-rC*dy/ 'd'set UR=dv[br]+dv[Br]set U[br]=U[Br]-(UR+$A)*dxset W[br]=W[Br]-(UR+$A)*dyendifcall xC()return falseendfunctionfunction iC takes nothing returns booleanlocal integer ZN=bV[bv[br]]local real dx=U[ZN]-U[br]local real dy=W[ZN]-W[br]local real UR=SquareRoot(dx*dx+dy*dy)local real vx=$3E8*.03*dx/ UR-Z[br]local real vy=$3E8*.03*dy/ UR-vv[br]local real v=SquareRoot(vx*vx+vy*vy)if not DV[bv[br]]thenset Ev[br]=1.5set mv[br]=nullset Pv[br]=nullreturn falseendifif UR<75 thencall lR(br,true)elseif v>0 thenset Z[br]=Z[br]+30*.03*vx/ vset vv[br]=vv[br]+30*.03*vy/ vendifreturn falseendfunctionfunction aC takes nothing returns booleanset xv[br]=iv[br]set ov[br]=av[br]set Ev[br]=Lv[br]set mv[br]=kireturn falseendfunctionfunction nC takes nothing returns nothinglocal integer vNlocal real dxlocal real dylocal real URlocal real VC=$5DC*.03local real EC=300*.03local real XClocal real OClocal real RC=800*(1+.12*Ri[Ni])local integer cO=Qvlocal real IC=38+Lolocal integer ACcall GO()loopexitwhen cO==0set Br=Rv[cO]if Jv[cO]thenset UR=bR(U[cO],W[cO],CX,CY)if UR<IC thenset IC=URset AC=cOendifendifset cO=Brendloopif IC<38+Lo thenset dx=U[AC]-CXset dy=W[AC]-CYset UR=SquareRoot(dx*dx+dy*dy)set dx=dx/ URset dy=dy/ URset vN=qR(2,Ni,'e000',U[AC]-dx*(Lo+38+2),W[AC]-dy*(Lo+38+2),270,"ArcaneGlaive.mdl")elseset vN=qR(2,Ni,'e000',CX,CY,270,"ArcaneGlaive.mdl")endifcall SetUnitColor(M[vN],GetPlayerColor(Player(Ni)))set dx=TX-CXset dy=TY-CYset Bv[vN]=2set cv[vN]=oi[Ni]set lv[vN]=0set fv[vN*3+1]=trueset fv[vN*3+3]=trueset dv[vN]=38set Mv[vN]=jiset Xv[vN]=1set mv[vN]=Jiset UR=SquareRoot(dx*dx+dy*dy)if UR<300 thenset UR=300endifset dy=dy/ URset dx=dx/ URif UR>RC thenset UR=RCendifset XC=-(VC*VC)/(2*UR)set OC=2*XC*EC/ VCif Nn[Ni]thenset EC=-ECset OC=-OCset Nn[Ni]=falseelseset Nn[Ni]=trueendifset Z[vN]=VC*dx+EC*(-dy)set vv[vN]=VC*dy+EC*(dx)set xv[vN]=XC*dx+OC*(-dy)set ov[vN]=XC*dy+OC*(dx)set Ev[vN]=-VC/ XC*.03set Lv[vN]=Ev[vN]-5*.03set iv[vN]=XC*dx-OC*(-dy)set av[vN]=XC*dy-OC*dxendfunctionfunction NC takes nothing returns booleanlocal integer cO=Qvlocal real URlocal integer id=bv[br]local integer NA=gV[id]local real bC=Lv[br]-KV[id]local real BC=4.+KV[id]local real kNlocal real H=0set Er=CreateUnit(Player(id),'e000',U[br],W[br],0)loopexitwhen cO==0if(Nv[cO]==1 and gV[bv[cO]]!=NA)or(Jv[cO]or Kv[cO])thenset kN=fR(cO,br)/ 85set kN=-kN*kN+bCif kN>(BC+KV[bv[cO]])thenset H=H+SN(U[br],W[br],br,cO,kN,.66)endifendifset cO=Rv[cO]endloopif DV[id]and H>.001 thencall qO(bV[id],H)endifcall SetUnitFlyHeight(M[br],0,0)call SetUnitPathing(Er,false)call SetUnitX(Er,U[br])call SetUnitY(Er,W[br])set UR=SquareRoot(bC-3)*80/ $B4call SetUnitScale(Er,UR,UR,UR)call DestroyEffect(AddSpecialEffectTarget("ExplosionBIG.mdl",Er,"origin"))call lR(br,true)call KillUnit(Er)return falseendfunctionfunction cC takes nothing returns booleanset Pv[br]=Raset mv[br]=Iaset Ev[br]=.6set Z[br]=Z[br]*'d'set vv[br]=vv[br]*'d'call AddSpecialEffectTarget("Abilities\\Weapons\\BallsOfFireMissile\\BallsOfFireMissile.mdl",M[br],"origin")return falseendfunctionfunction CC takes nothing returns booleancall SetUnitFlyHeight(M[br],Ev[br]/ .6*700,0)return falseendfunctionfunction MeteorEffectEnd takes nothing returns nothingcall DestroyEffect(Re)endfunctionfunction dC takes nothing returns nothinglocal integer vNlocal real DClocal real dxlocal real dylocal real URlocal real fC=$3E8local integer FC=GetTerrainType(U[bi],W[bi])local integer gCcall GO()set dx=TX-CXset dy=TY-CYset UR=SquareRoot(dx*dx+dy*dy)if UR>fC thenset TX=CX+fC*dx/ URset TY=CY+fC*dy/ URendifset vN=qR(2,Ni,'e001',TX-400*dx/ UR,TY-400*dy/ UR,GetUnitFacing(M[bi]),null)call UnitAddAbility(M[vN],'Amrf')call UnitRemoveAbility(M[vN],'Amrf')call SetUnitFlyHeight(M[vN],700,0)set cv[vN]=ri[Ni]set Bv[vN]=8set mv[vN]=Aaset Lv[vN]=$A+ri[Ni]set DC=SquareRoot(Lv[vN]-3.)*80/ $B4call SetUnitScale(M[vN],DC,DC,DC)set Ev[vN]=.55call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\SearingArrow\\SearingArrowMissile.mdl",M[bi],"weapon"))set TX=TX-CXset TY=TY-CYset Cr=400/ .6*.03set Z[vN]=Cr*dx/ UR*.01set vv[vN]=Cr*dy/ UR*.01endfunctionfunction GC takes integer hN,real DO,real uN,real UN returns nothinglocal integer id=bv[hN]local integer cO=svlocal integer nlocal real URlocal real x=U[hN]local real y=W[hN]local integer NA=gV[id]local real wN=.5local real hC=(1+.12*Ri[id])*400local integer HC=zN(x,y,NA)local real kNloopexitwhen cO==0set n=Rv[cO]set id=bv[cO]if gV[id]!=NA thenset UR=bR(U[cO],W[cO],x,y)if cO==HC and UR<1.25*hC thenset kN=1-UR/ UNset kN=DO*(wN+(1-wN)*kN)if kN<DO/ 1.5 thenset kN=DO/ 1.5endifcall kc(hN,50,x,y,(-x+U[cO])/ UR,(-y+W[cO])/ UR,hC,kN,"CHIM")elseif UR<=UN thenset UR=1-UR/ UNcall sN(hN,cO,DO*(wN+(1-wN)*UR),uN)endifendifset cO=nendloopendfunctionfunction jC takes nothing returns nothingset jr[ae]=falsecall DestroyEffect(Re)set CV[bv[ae]]=CV[bv[ae]]+Eeset lV[bv[ae]]=lV[bv[ae]]*10.endfunctionfunction JC takes nothing returns nothingset jr[ae]=falsecall DestroyEffect(Re)set CV[bv[ae]]=CV[bv[ae]]+Eeset lV[bv[ae]]=lV[bv[ae]]*10.set LV[bv[ae]]=LV[bv[ae]]/ 1.2endfunctionfunction kC takes nothing returns booleanlocal integer bflocal integer idif Nv[Br]==1 thenif jr[Br]and ur[Br]thenset id=bv[br]set bf=Ib(Ir,Br,id)if bf==0 thenset bf=Cb(Ir,bV[id],Br,.3+.3*cv[br],.2)call bb(bf,(.5*mV[(bv[Br])]*jo),true)elsecall cb(bf,1.5)endifelseif ur[Br]thenif not XE thenset jr[Br]=trueset id=bv[Br]if qv[br]==Za thenset lV[id]=lV[id]*.1if GetLocalPlayer()==Player(id)or GetLocalPlayer()==Player(bv[br])thencall ic("烤肉饼",$FF,30,30,.026,Br,Ro)endifset oe[(OI(function jC,4*MV[bv[br]]*pV[id],Br,0,Ne,CV[id],0,0))]=(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Thunderclap\\ThunderclapTarget.mdl",M[Br],"overhead"))elseset lV[id]=lV[id]*.1set LV[id]=LV[id]*1.2if GetLocalPlayer()==Player(id)or GetLocalPlayer()==Player(bv[br])thencall ic("烤肉饼!",90,30,$FF,.026,Br,Ro)endifset oe[(OI(function JC,4*MV[bv[br]]*pV[id],Br,0,Ne,CV[id],0,0))]=(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\StasisTrap\\StasisTotemTarget.mdl",M[Br],"overhead"))endifcall DestroyEffect(AddSpecialEffect(UV[id],U[Br],W[Br]))set CV[id]=0endifelseset id=bv[br]set bf=Ib(Ir,Br,id)set id=bV[id]if lv[id]==Br thenset Cr=(.5+.3*cv[br])/ 2elseset Cr=.5+.3*cv[br]endifif bf==0 thenset bf=Cb(Ir,id,Br,Cr,.25)call bb(bf,(.5*mV[(bv[Br])]*jo),true)elsecall cb(bf,.25)set ye[bf]=Crendifset dr=425*.03-(iv[br]*Z[Br]+av[br]*vv[Br])if dr>0 thenset Z[Br]=Z[Br]+dr*iv[br]set vv[Br]=vv[Br]+dr*av[br]endifendifelseif Nv[Br]==2 thenif Bv[Br]==16 thencall aA(br)elseset dv[br]=SquareRoot(dv[br]*dv[br]+$3E8)call SetUnitScale(M[br],dv[br]/ 32.727,dv[br]/ 32.727,dv[br]/ 32.727)if Kv[Br]thenset lv[Br]=bv[br]call aA(Br)endifendifelseif Jv[Br]thencall aA(br)call sN(br,Br,$A+2*cv[br],.8)endifreturn falseendfunctionfunction KC takes nothing returns booleanlocal real IO=3.+1.