ll ShowUnit(NV[i],false)call ShowUnit(AV[i],true)call IssueImmediateOrderById(AV[i],$D0004)if not Cn thenset fH=FH+DH*QE[i]call Vd(bV[i],vC*Cos(fH),vC*Sin(fH))call SetUnitFacing(AV[i],FR(fH*bj_RADTODEG-$B4,true))elseset h=QE[gV[i]]call Vd(bV[i],WE[h*2],WE[h*2+1])call SetUnitFacing(AV[i],GetRandomReal(0,360))endifset cV[i]=0call eR(i,3,"0")call eR(i,0,VO(i))set j=0loopexitwhen j>$Bset wV[i*$C+j]=0set j=j+1endloopset dV[i]=ZEset hV[i]=0set hV[i+$C]=0if GetLocalPlayer()==Player(i)thencall PanCameraToTimed(GetUnitX(AV[i]),GetUnitY(AV[i]),0)endifendifset i=i+1endloopcall pg()set tE=tE+1set XE=falsecall kF()call zX("回合 |c0000FF00"+I2S(tE)+"|r/"+I2S(TE)+".")call MultiboardSetTitleText(OX[0],"回合 "+I2S(tE)+"/"+I2S(TE))call TriggerSleepAction(1)call MultiboardDisplay(OX[0],true)call EnableSelect(true,true)call ClearSelection()set i=0loopexitwhen i>$Bif fV[i]thenif GetLocalPlayer()==Player(i)thencall SelectUnit(AV[i],true)endifcall AN(i)endifset i=i+1endloopendfunctionfunction QH takes nothing returns nothingcall ExecuteFunc("qH")endfunctionfunction gN takes nothing returns nothinglocal integer i=0local integer jlocal real klocal integer Nblocal real xlocal integer cOlocal real aN=0local integer sHlocal boolean array SHcall EnableSelect(false,false)set XE=truecall Sb(false)loopexitwhen i==$Cif fV[i]thenif i==ZE thenset iX[i]=0set j=0set Cr=0loopexitwhen j==$Cif fV[j]thenset Cr=Cr+wV[j*$C+ZE]endifset j=j+1endloopset ZV[i]=ZV[i]+R2I((Cr)/ 20)elseif DV[i]thenset iX[i]=wV[ZE*$C+i]+iX[i]elseset iX[i]=wV[ZE*$C+i]/ 2.+iX[i]endifset ZV[i]=ZV[i]+R2I((iX[i])/ 20)endifcall eR(i,2,I2S(ZV[i]))endifset i=i+1endloopset j=0loopexitwhen j==$Cif fV[j]thenset k=-1.set i=0loopexitwhen i==$Cif iX[i]>=k and fV[i]and(not SH[i])thenset k=iX[i]set Nb=iendifset i=i+1endloopset SH[Nb]=trueif j==0 thenset sH=Nbendifcall ZX(I2S(R2I(iX[Nb]))+" : "+FV[Nb]+"|r",20)endifset j=j+1endloopset i=0call ClearSelection()call CinematicFadeBJ(1,1.4,"ReplaceableTextures\\CameraMasks\\Black_mask.blp",0,0,0,0)call TriggerSleepAction(1.4)call PanCameraToTimed(0,0,0)if tE>=TE thencall PauseTimer(uE)call ExecuteFunc("RN")endifset CV[vX]=CV[vX]-xXset mV[vX]=mV[vX]*oXset pV[vX]=pV[vX]/ rXcall UnitAddAbility(AV[vX],'A005')call SetUnitAbilityLevel(AV[vX],'A005',eX)call UnitRemoveAbility(AV[vX],'A005')call JA(bV[vX],KA(bV[vX])-60)call SetPlayerAbilityAvailable(Player(vX),'S020',false)call SetPlayerAbilityAvailable(Player(vX),WV[8*vX+7],true)call SetUnitAbilityLevel(AV[vX],WV[8*vX+7],1+Xi[vX])set lV[vX]=lV[vX]/ 1.5set sV[vX]=sV[vX]/ 1.45call SetUnitScale(AV[vX],sV[vX],sV[vX],sV[vX])set dv[bV[vX]]=dv[bV[vX]]-20set PV[vX]=PV[vX]-7.call hA()loopexitwhen i>$Bif fV[i]thenif DV[i]thenset KE[i]=KE[i]+TimerGetElapsed(wv)-lE[i]endifset x=$80*(i-6)-64set cO=0set DV[i]=truecall ShowUnit(NV[i],true)call ShowUnit(AV[i],true)call IssueImmediateOrderById(AV[i],$D0004)call Vd(bV[i],x,-64)call SetUnitFacing(AV[i],270)call jR(bV[i],1)call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)+Wo)if(GetLocalPlayer()==Player(i))and not RE thencall SelectUnit(NV[i],true)endifendifset i=i+1endloopcall TimerStart(uE,er,false,function QH)call Sb(false)call pb(8+aE/ 2)call dB(0)call zX("|cffdaa520回合结束|r |c0000FF00"+I2S(tE)+"|r.")call zX("")if RE thenreturnendifcall CinematicFadeBJ(0,1.4,"ReplaceableTextures\\CameraMasks\\Black_mask.blp",0,0,0,0)set UE=CreateTimerDialog(uE)call TimerDialogSetTitle(UE,"购物时间:")call TimerDialogDisplay(UE,true)call TriggerSleepAction(1)call EnableSelect(true,true)call MultiboardDisplay(OX[0],true)call fI(tE)endfunctionfunction fg takes nothing returns nothinglocal integer i=0local real xlocal integer cOcall EnableSelect(true,true)set OE=trueset EE=trueset rE=0set ZE=$Cloopexitwhen i>$Bif fV[i]thenset iX[i]=0if GetPlayerSlotState(Player(i))!=PLAYER_SLOT_STATE_PLAYING thenset DV[i]=falseset fV[i]=falsecall zX(GetPlayerName(Player(i))+" 断开连接.")elseset x=$80*(i-6)-64set rE=rE+1set aE=aE+1call Vd(bV[i],x,-64)set NV[i]=CreateUnit(Player(i),Po,x,64,270)call SetUnitPathing(NV[i],false)set DV[i]=trueset gV[i]=0call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,yo)endifendifset i=i+1endloopcall pg()call TimerStart(uE,xr,false,function QH)set UE=CreateTimerDialog(uE)call TimerDialogSetTitle(UE,"购物时间:")call TimerDialogDisplay(UE,true)call PauseTimer(kn)call pb(8+aE/ 2)call ExecuteFunc("rh")if Cn and lx thencall SetTerrainType(0,0,Hn[Bn],-1,42,1)call xO("call to CTC->-ApplyTerrain")endifcall yb()call AbortCinematicFadeBJ()call CinematicFadeCommonBJ(0,0,0,1,"ReplaceableTextures\\CameraMasks\\Black_mask.blp",0,'d')call FinishCinematicFadeAfterBJ(1)endfunctionfunction tH takes nothing returns nothinglocal integer i=0local integer h=0local integer j=0local integer k=0local real DH=360/ rE*bj_DEGTORADlocal real fH=GetRandomReal(0,360*bj_DEGTORAD)local real FH=fHlocal real vC=768+64*SquareRoot(2*rE)local real xH=TimerGetElapsed(wv)local integer cOlocal string vs=""local real array gHlocal integer GH=0set wE=falsecall PauseTimer(uE)call DestroyTimerDialog(UE)call ClearSelection()call EnableSelect(false,false)call CinematicFadeBJ(2,3.,"ReplaceableTextures\\CameraMasks\\Black_mask.blp",0,0,0,0)call TriggerSleepAction(1.4)if Yn thencall JO()endifcall gO()loopexitwhen i>$Bif fV[aX[i]]and aX[i]!=$C thencall SetPlayerAbilityAvailable(Player(aX[i]),WV[8*aX[i]+7],false)call SetPlayerAbilityAvailable(Player(aX[i]),'S021',true)set nX[i]=AddSpecialEffectTarget("crown.mdl",AV[aX[i]],"head second")set nX[i+$C]=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\CommandAura\\CommandAura.mdl",AV[aX[i]],"origin")set LV[aX[i]]=LV[aX[i]]*9./ 10.set vr[aX[i]]=vr[aX[i]]*9./ 10.set vs=vs+FV[aX[i]]+"|r vs. "endifset i=i+1endloopset vs=SubString(vs,0,StringLength(vs)-5)set i=0set aE=0if not EE thenif not Cn thenset j=0loopexitwhen j>$Bset gH[j]=0set j=j+1endloopset j=0loopexitwhen j>$Bif fV[j]thenset gH[gV[j]]=gH[gV[j]]+1endifset j=j+1endloopset j=0loopexitwhen j>$Bif gH[j]>0 thenset GH=GH+1endifset j=j+1endloopset DH=360/ GH*bj_DEGTORADset j=0loopexitwhen j>$Bif gH[j]>0 thenset gH[j+$C]=fHset fH=fH+DHendifset j=j+1endloopendifelseif not Cn thencall Qh()endifif Cn thencall Sh()endifcall hA()loopexitwhen i>$Bif fV[i]thenset DV[i]=trueset lE[i]=xHset aE=aE+1call ShowUnit(NV[i],false)call ShowUnit(AV[i],true)call IssueImmediateOrderById(AV[i],$D0004)if not Cn thenif EE thenset fH=FH+DH*QE[i]call Vd(bV[i],vC*Cos(fH),vC*Sin(fH))call SetUnitFacing(AV[i],FR(fH*bj_RADTODEG-$B4,true))elsecall Vd(bV[i],vC*Cos(gH[gV[i]+$C]),vC*Sin(gH[gV[i]+$C]))call SetUnitFacing(AV[i],FR(gH[gV[i]+$C]*bj_RADTODEG-$B4,true))endifelseset h=QE[gV[i]]call Vd(bV[i],WE[h*2]+GetRandomReal(-$96,$96),WE[h*2+1]+GetRandomReal(-$96,$96))call SetUnitFacing(AV[i],GetRandomReal(0,360))endifset cV[i]=0call eR(i,3,"0")call eR(i,0,VO(i))set j=0loopexitwhen j>$Bset wV[i*$C+j]=0set j=j+1endloopset dV[i]=$Cset hV[i+$C]=0if GetLocalPlayer()==Player(i)thencall PanCameraToTimed(GetUnitX(AV[i]),GetUnitY(AV[i]),0)endifset k=k+1endifset i=i+1endloopset tE=tE+1set XE=falsecall kF()call zX("回合 |c0000FF00"+I2S(tE)+"|r/"+I2S(TE)+" "+vs)call MultiboardSetTitleText(OX[0],"回合 "+I2S(tE)+"/"+I2S(TE))call TriggerSleepAction(1)call MultiboardDisplay(OX[0],true)call EnableSelect(true,true)call ClearSelection()set i=0loopexitwhen i>$Bif fV[i]thenif GetLocalPlayer()==Player(i)thencall SelectUnit(AV[i],true)endifcall AN(i)endifset i=i+1endloopendfunctionfunction TH takes nothing returns nothingcall ExecuteFunc("tH")endfunctionfunction nN takes nothing returns nothinglocal integer i=0local real xlocal integer cOlocal real aN=0local real xH=TimerGetElapsed(wv)set XE=trueloopexitwhen i>$Bif aX[i]!=$C thencall DestroyEffect(nX[i])call DestroyEffect(nX[i+$C])call SetPlayerAbilityAvailable(Player(aX[i]),'S021',false)call SetPlayerAbilityAvailable(Player(aX[i]),WV[8*aX[i]+7],true)set LV[aX[i]]=LV[aX[i]]*10./ 9.set vr[aX[i]]=vr[aX[i]]*10./ 9.endifset i=i+1endloopset i=0call Sb(false)loopexitwhen i==$Cset cV[$C+i]=cV[$C+i]+cV[i]set i=i+1endloopset i=0call ClearSelection()call EnableSelect(false,false)call CinematicFadeBJ(1,1.4,"ReplaceableTextures\\CameraMasks\\Black_mask.blp",0,0,0,0)call TriggerSleepAction(1.4)call PanCameraToTimed(0,0,0)if tE>=TE thencall PauseTimer(uE)set EE=falsecall ExecuteFunc("RN")endifset i=0call hA()loopexitwhen i>$Bif fV[i]thenset x=$80*(i-6)-64if DV[i]thenset KE[i]=KE[i]+xH-lE[i]endifset DV[i]=truecall ShowUnit(NV[i],true)call ShowUnit(AV[i],true)call IssueImmediateOrderById(AV[i],$D0004)call Vd(bV[i],x,-64)call SetUnitFacing(AV[i],270)call jR(bV[i],1)call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)+Wo)if(GetLocalPlayer()==Player(i))and not RE thencall SelectUnit(NV[i],true)endifendifset i=i+1endloopcall TimerStart(uE,er,false,function TH)call Sb(false)call pb(8+aE/ 2)call dB(0)call zX("|cffdaa520回合结束|r |c0000FF00"+I2S(tE)+"|r.")call zX("")if RE thenreturnendifcall CinematicFadeBJ(0,1.4,"ReplaceableTextures\\CameraMasks\\Black_mask.blp",0,0,0,0)set UE=CreateTimerDialog(uE)call TimerDialogSetTitle(UE,"购物时间:")call TimerDialogDisplay(UE,true)call TriggerSleepAction(1)call EnableSelect(true,true)call MultiboardDisplay(OX[0],true)call fI(tE)endfunctionfunction Fg takes nothing returns nothinglocal integer i=0local real xlocal integer cOcall EnableSelect(true,true)set rE=0set OE=trueloopexitwhen i>$Bset aX[i]=$Cif fV[i]thenif GetPlayerSlotState(Player(i))!=PLAYER_SLOT_STATE_PLAYING thenset DV[i]=falseset fV[i]=falsecall zX(GetPlayerName(Player(i))+"|r 断开连接.")elseset x=$80*(i-6)-64set rE=rE+1set aE=aE+1call Vd(bV[i],x,-64)set NV[i]=CreateUnit(Player(i),Po,x,64,270)call SetUnitPathing(NV[i],false)set DV[i]=truecall SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,yo)endifendifset i=i+1endloopcall TimerStart(uE,xr,false,function TH)set UE=CreateTimerDialog(uE)call TimerDialogSetTitle(UE,"购物时间:")call TimerDialogDisplay(UE,true)call PauseTimer(kn)call pb(8+aE/ 2)if Cn and lx thencall SetTerrainType(0,0,Hn[Bn],-1,42,1)call xO("call to CTC->-ApplyTerrain")endifcall ExecuteFunc("rh")call yb()call AbortCinematicFadeBJ()call CinematicFadeCommonBJ(0,0,0,1,"ReplaceableTextures\\CameraMasks\\Black_mask.blp",0,'d')call FinishCinematicFadeAfterBJ(1)endfunctionfunction uH takes string UH,integer id returns nothinglocal string jGlocal integer ilocal integer array jlocal real rlocal integer wHif(SubString(UH,0,1)!="-")thenreturnendifif SubString(UH,0,4)=="-cam" and not RE thenif SubString(UH,4,5)==" " thenset bE[id]=S2R(SubString(UH,5,$B))call DisplayTextToPlayer(Player(id),0,0,"镜头距离设置为 |cffffcc00"+I2S(S2I(SubString(UH,5,$B)))+"|r")elseset bE[id]=S2R(SubString(UH,4,$A))call DisplayTextToPlayer(Player(id),0,0,"镜头距离设置为 |cffffcc00"+I2S(S2I(SubString(UH,4,$A)))+"|r")endifelseif SubString(UH,0,6)=="-stats" thencall DisplayTimedTextToPlayer(Player(id),0,0,$A,"|cffffcc00移动速度: |r "+R2S((KA(bV[(id)]))))call DisplayTimedTextToPlayer(Player(id),0,0,$A,"|cffffcc00生命回复速度: |r "+R2S($A*CV[id]*QV[id])+"/秒")call DisplayTimedTextToPlayer(Player(id),0,0,$A,"|cffffcc00击退值: |r "+R2S('d'*mV[id])+"%")call DisplayTimedTextToPlayer(Player(id),0,0,$A,"|cffffcc00伤害值: |r "+R2S('d'*LV[id])+"%")call DisplayTimedTextToPlayer(Player(id),0,0,$A,"|cffffcc00生命偷取负抗性: |r "+R2S('d'*qV[id])+"%")call DisplayTimedTextToPlayer(Player(id),0,0,$A,"|cffffcc00增益持续时间: |r "+R2S('d'*MV[id])+"%")call DisplayTimedTextToPlayer(Player(id),0,0,$A,"|cffffcc00减益持续时间: |r "+R2S('d'*pV[id])+"%")call DisplayTimedTextToPlayer(Player(id),0,0,$A,"|cffffcc00质量: |r "+R2S('d'*PV[id])+"千克")elseif UH=="-autoselect" thenif BE[id]thenset BE[id]=falsecall DisplayTimedTextToPlayer(Player(id),0,0,5,"自动选择: |cffffcc00关闭|r")elseset BE[id]=truecall DisplayTimedTextToPlayer(Player(id),0,0,5,"自动选择: |cffffcc00开启|r")endifelseif UH=="-apm" thenset i=0loopexitwhen i==$Cif fV[i]thenif DV[i]and not XE thencall DisplayTimedTextToPlayer(Player(id),0,0,rE+3,FV[i]+"|r "+R2S(60*JE[i]/(KE[i]+TimerGetElapsed(wv)-lE[i])))elsecall DisplayTimedTextToPlayer(Player(id),0,0,rE+3,FV[i]+"|r "+R2S(60*JE[i]/ KE[i]))endifendifset i=i+1endloopelseif UH=="-afk" and OE and not zn thenif(xV==2 or xV==5)thenif DV[id]thencall DisplayTextToPlayer(Player(id),0,0,"无法在活着时设置AFK")returnendifelseif not XE thencall DisplayTextToPlayer(Player(id),0,0,"无法在回合中设置AFK")returnendifcall ah(id)elseif UH=="-unpause" thenif(id==0 or not fV[0])and IE and tE==0 and XE thenif not tO()thencall PauseGame(false)set IE=falseendifendifelseif SubString(UH,0,5)=="-sell" thencall Ah(S2I(SubString(UH,6,7))-1,id)elseif SubString(UH,0,4)=="-fbc" thenif UH=="-fbc original" thenset HV[id*4]=0call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"火球颜色 = 原始")elseif SubString(UH,5,6)=="#" thenset UH=SubString(UH,6,StringLength(UH))if StringLength(UH)==3 thenset UH=SubString(UH,0,1)+SubString(UH,0,1)+SubString(UH,1,2)+SubString(UH,1,2)+SubString(UH,2,3)+SubString(UH,2,3)endifif StringLength(UH)==6 thencall uH("-fbc "+I2S((qB(SubString(("|cff"+UH),4,6))))+" "+I2S((qB(SubString(("|cff"+UH),6,8))))+" "+I2S((qB(SubString(("|cff"+UH),8,$A)))),id)elsecall uH("-fbc 70 70 70",id)endifelseset i=0set j[0]=0loopif SubString(UH,5+i,6+i)==" " thenset j[0]=j[0]+1set j[j[0]]=5+ielseif SubString(UH,5+i,6+i)==null thenset j[4]=5+iendifset i=i+1exitwhen j[4]!=nullendloopset HV[id*4]=-1set HV[id*4+1]=S2I(SubString(UH,5,j[1]))if HV[id*4+1]>$FF thenset HV[id*4+1]=$FFelseif HV[id*4+1]<0 thenset HV[id*4+1]=0endifset HV[id*4+2]=S2I(SubString(UH,j[1],j[2]))if HV[id*4+2]>$FF thenset HV[id*4+2]=$FFelseif HV[id*4+2]<0 thenset HV[id*4+2]=0endifset HV[id*4+3]=S2I(SubString(UH,j[2],j[3]))if HV[id*4+3]>$FF thenset HV[id*4+3]=$FFelseif HV[id*4+3]<0 thenset HV[id*4+3]=0endifset wH=HV[id*4+1]+HV[id*4+2]+HV[id*4+3]if wH<$D2 thenif wH==0 thenset wH=wH+3set HV[id*4+1]=(HV[id*4+1]+1)set HV[id*4+2]=(HV[id*4+2]+1)set HV[id*4+3]=(HV[id*4+3]+1)endifset HV[id*4+1]=HV[id*4+1]*$D2/ wHset HV[id*4+2]=HV[id*4+2]*$D2/ wHset HV[id*4+3]=HV[id*4+3]*$D2/ wHendifcall DisplayTextToPlayer(GetTriggerPlayer(),0,0,"火球颜色 = |c00FF0000"+I2S(HV[id*4+1])+"|r |c0000FF00"+I2S(HV[id*4+2])+"|r |c000000FF"+I2S(HV[id*4+3])+"|r.")endifset j[0]=0set j[1]=0set j[2]=0set j[3]=0set i=0elseif SubString(UH,0,8)=="-terrain" and id==0 and AE thenset i=S2I(SubString(UH,9,$A))if i>0 and i<=5 thenset Bn=iset cn=truecall SetTerrainType(0,0,Hn[Bn],-1,'d',1)call pb(ln)endifelseif UH=="-teamshuffle" and id==0 and not zn and(XE or xV==2)and xV!=3 and OE thenset i=0loopexitwhen i>$Bset ZV[i]=0set i=i+1endloopcall JO()elseif SubString(UH,0,6)=="-teams" and not zn and id==0 and(XE or xV==2)and xV!=3 and OE thencall Vg(SubString(UH,6,19))elseif(SubString(UH,0,4)=="-bot" or SubString(UH,0,4)=="-war" or SubString(UH,0,4)=="-her" or SubString(UH,0,4)=="-inq" or SubString(UH,0,4)=="-occ")and AE and id==0 thenset i=S2I(SubString(UH,5,7))if i>$B or i<0 thenreturnendifif not fV[i]thencall SetPlayerAlliance(Player(i),Player(0),ALLIANCE_SHARED_CONTROL,true)call SetPlayerAlliance(Player(0),Player(i),ALLIANCE_SHARED_CONTROL,true)call SetPlayerAlliance(Player(i),Player(0),ALLIANCE_SHARED_ADVANCED_CONTROL,true)call SetPlayerAlliance(Player(0),Player(i),ALLIANCE_SHARED_ADVANCED_CONTROL,true)set rE=rE+1set iE=iE+1if SubString(UH,0,4)=="-her" thencall SG(i,i,'h003',"HereticModel.mdl",.96,'thr2','S022')elseif SubString(UH,0,4)=="-inq" thencall SG(i,i,'h00J',"FireMageModel.mdl",.95,'thr3','S023')elseif SubString(UH,0,4)=="-occ" thencall SG(i,i,'h009',"OccultistModel.mdl",.98,'thr4','S051')elsecall SG(i,i,'h000',"WarlockModel.mdl",.92,'thrd','S001')endifset lE[i]=TimerGetElapsed(wv)set FV[i]=yV[i]+"Bot "+I2S(i)set FV[i+$C]="Bot "+I2S(i)call SetPlayerName(Player(i),FV[i+$C])call ForceAddPlayer(oE,Player(i))call jA(i,270)call SetUnitColor(AV[i],GetPlayerColor(Player(i)))call Vd(bV[i],$80*(i-6)-64,-64)set NV[i]=CreateUnit(Player(i),Po,$80*(i-6)-64,64,270)set j[0]=pEloopexitwhen ME[j[0]]==nullset j[0]=j[0]+1endloopset j[1]=8loopexitwhen j[1]>j[0]call SetPlayerTechMaxAllowed(Player(i),ME[j[1]],0)set j[1]=j[1]+1endloopcall SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,yo)call xR(i)call MultiboardDisplay(OX[0],true)call DisplayTextToPlayer(Player(0),0,0,"在 "+I2S(i)+" 号玩家位添加机器人.")elsecall DisplayTextToPlayer(Player(0),0,0,"错误: 玩家位置已被占用.")endifelseif UH=="-quit local" thenif GetLocalPlayer()==Player(id)thencall EndGame(false)endifelseif((AE and id==0))and SubString(UH,0,$D)=="-quit player " thenset i=S2I(SubString(UH,$D,$E))if i!=id thenif GetLocalPlayer()==Player(i)thencall EndGame(false)endifendifelseif UH=="-restart" and(id==0)thencall RestartGame(false)elseif UH=="-debug" thenif GetLocalPlayer()==GetTriggerPlayer()thencall DisplayCineFilter(false)call EnableUserUI(true)endifelseif UH=="-title" and CE[id]==0 thencall JG(id)if CE[id]!=0 thenif gV[id]!=$C thenset FV[id]=rO(id)elseset FV[id]="|c00707070"+nO(id)+" (观看者)"call SetPlayerName(Player(id),FV[id])endifif not RE and gV[id]!=$C thenif DV[id]thencall MultiboardSetItemValue(MultiboardGetItem(OX[0],L[GetPlayerId(GetTriggerPlayer())],0),VO(id)+"|r")elsecall MultiboardSetItemValue(MultiboardGetItem(OX[0],L[GetPlayerId(GetTriggerPlayer())],0),XO(id)+"|r")endifcall MultiboardReleaseItem(MultiboardGetItem(OX[0],L[GetPlayerId(GetTriggerPlayer())],0))endifendifelseif UH=="-untitle" and CE[id]!=0 thenset CE[id]=0if gV[id]!=$C thenset FV[id]=rO(id)call SetPlayerName(Player(id),FV[id+$C])elseset FV[id]="|c00707070"+FV[id+$C]+" (观看者)"call SetPlayerName(Player(id),FV[id])endifif not RE and gV[id]!=$C thenif DV[id]thencall MultiboardSetItemValue(MultiboardGetItem(OX[0],L[GetPlayerId(GetTriggerPlayer())],0),VO(id)+"|r")elsecall MultiboardSetItemValue(MultiboardGetItem(OX[0],L[GetPlayerId(GetTriggerPlayer())],0),XO(id)+"|r")endifcall MultiboardReleaseItem(MultiboardGetItem(OX[0],L[GetPlayerId(GetTriggerPlayer())],0))endifelseif UH=="-n" thenif GetLocalPlayer()==Player(id)thencall ClearTextMessages()endifelseif UH=="-hat" thenif VE[id]thencall Jh('ihat',id)endifelseif UH=="-tutorial" thenif not EX[id]thenset EX[id]=truecall DisplayTimedTextToPlayer(Player(id),0,0,20,"|cffffff00启用教程|r")call DisplayTimedTextToPlayer(Player(id),0,0,20,"输入 |cffffcc00-ttutorial|r 或 |cffffcc00-thint|r 切换开关.")call DisplayTimedTextToPlayer(Player(id),0,0,20,"输入 |cffffcc00-step #|r 和 |cffffcc00-hint #|r 重新读取步骤/提示. (|cffffcc00-n|r 清除你的屏幕上的信息.)")if OE and XE thencall dI(id,tE+1,TimerGetRemaining(uE))endifelseset EX[id]=falsecall DisplayTextToPlayer(Player(id),0,0,"|cffffff00关闭教程|r")endifelseif SubString(UH,0,3)=="-cf" thenset j[0]=4if SubString(UH,0,4)=="-cfa" thenset j[0]=j[0]+1call uH("-autoselect",id)endifif SubString(UH,j[0]-1,j[0])!=" " thenset j[0]=j[0]-1endifset j[1]=j[0]if SubString(UH,j[0],StringLength(UH))!=null thenloopexitwhen SubString(UH,j[1],j[1]+1)==" " or SubString(UH,j[1],j[1]+1)==nullset j[1]=j[1]+1endloopcall uH("-cam"+SubString(UH,j[0],j[1]+1),id)endifif SubString(UH,j[1]+1,StringLength(UH))!=null thencall uH("-fbc "+SubString(UH,j[1]+1,StringLength(UH)),id)endifendifset UH=""set jG=""endfunctionfunction WH takes nothing returns nothingcall uH(GetEventPlayerChatString(),GetPlayerId(GetTriggerPlayer()))endfunctionfunction yH takes nothing returns nothinglocal trigger t=CreateTrigger()local integer i=0loopexitwhen i>$Bcall TriggerRegisterPlayerChatEvent(t,Player(i),"-",false)set i=i+1endloopcall TriggerAddAction(t,function WH)endfunctionfunction ZG takes nothing returns nothinglocal string slocal integer array hlocal integer i=-1if i>=0 thenset s="RGC 积分正在保存 - 在声音提示前请不要离开游戏"+I2S(i)elseset s=nullreturnendifif i==0 thencall DisplayTextToPlayer(Player(0),0,0,"你现在可以离开游戏. 本次比赛不计分因为不是在RGC平台上进行. 更多信息请关注 www.warlockbrawl.com. 请参阅统计栏目 (inf)¨)returnendifcall DisplayTextToPlayer(Player(0),0,0,s)set s = nullendfunctionfunction hX takes nothing returns nothinglocal integer i=0local integer j=0local integer P=0local integer array xlocal integer array ylocal integer array hloopexitwhen i==$Cif zn[i]thenif vV[i]==0 thenset x[j]=iset j=j+1elseset y[P]=iset P=P+1endifendifset i=i+1endloopset BE=x[GetRandomInt(0,j-1)]set cE=y[GetRandomInt(0,P-1)]set BE=x[GetRandomInt(0,j-1)+cE[j+1]]set cE=y[GetRandomInt(0,P-1)+BE[P+1]]set BE=x[GetRandomInt(0,j-1)+cE[j+2]]set cE=y[GetRandomInt(0,P-1)+BE[P+2]]set BE=x[GetRandomInt(0,j-1)+cE[j+3]]set cE=y[GetRandomInt(0,P-1)+BE[P+3]]set BE=x[GetRandomInt(0,j-1)+cE[j+4]]set cE=y[GetRandomInt(0,P-1)+BE[P+4]]set BE=x[GetRandomInt(0,j-1)+cE[j+5]]set cE=y[GetRandomInt(0,P-1)+2*BE[P+5]]if x[1]==1 thencall ExecuteFunc(")endifif i==0 thenset h[0]=0set h[1]=1elseset h[2*i]=1set h[2*i+1]=1endifendfunctionfunction YH takes integer id,integer zH returns nothingif LE[18+27*id]thenif zH=='T000' thencall SetPlayerTechMaxAllowed(Player(id),'R002',GetPlayerTechMaxAllowed(Player(id),'R002')+2)elseif zH=='T002' or zH=='T003' or zH=='T004' thenif GetPlayerTechMaxAllowed(Player(id),'R010')>0 thencall SetPlayerTechMaxAllowed(Player(id),'R010',GetPlayerTechMaxAllowed(Player(id),'R010')+2)elseif GetPlayerTechMaxAllowed(Player(id),'R00O')>0 thencall SetPlayerTechMaxAllowed(Player(id),'R00O',GetPlayerTechMaxAllowed(Player(id),'R00O')+2)elseif GetPlayerTechMaxAllowed(Player(id),'R00P')>0 thencall SetPlayerTechMaxAllowed(Player(id),'R00P',GetPlayerTechMaxAllowed(Player(id),'R00P')+2)endifelseif zH=='T011' or zH=='T012' 