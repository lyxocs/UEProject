s nothingcall DestroyEffect(Re)endfunctionfunction Oc takes nothing returns booleancall DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIfb\\AIfbSpecialArt.mdl",U[br],W[br]))call KillUnit(M[br])call lR(br,false)return falseendfunctionfunction Rc takes nothing returns booleanlocal integer id=bv[br]call DestroyEffect(AddSpecialEffect("fbenddeathsound.mdl",U[br],W[br]))call SetUnitScale(M[br],.5,.5,.5)call KillUnit(M[br])call lR(br,false)return falseendfunctionfunction Ic takes nothing returns booleanlocal integer id=bv[br]if Nv[Br]==1 thencall sN(br,Br,.5*cv[br],1/(.5*cv[br]))set fv[3*br+1]=falseset fv[3*br+2]=falseset fv[3*br+3]=falsecall aA(br)elseif Nv[Br]==2 thenset fv[3*br+1]=falseset fv[3*br+2]=falseset fv[3*br+3]=falsecall aA(br)if Kv[Br]thencall sN(br,Br,.5*cv[br],1)endifelseif Nv[Br]==3 and hr[id]==0 thencall sN(br,Br,.5*cv[br],1)set fv[3*br+1]=falseset fv[3*br+2]=falseset fv[3*br+3]=falsecall aA(br)endifreturn falseendfunctionfunction Ac takes real Nc,real SR,integer bc returns nothinglocal integer vNlocal integer Bc=4*Ni+512local integer cc=4*Ni+513local real xlocal real ylocal real dx=U[bi]-GetUnitX(M[Bc])local real dy=W[bi]-GetUnitY(M[Bc])if HV[Ni*4]==0 thenset vN=qR(2,Ni,'e000',CX-dx,CY-dy,SR,"fbnosound.mdl")elseif HV[Ni*4]==-1 thenset vN=qR(2,Ni,'e000',CX-dx,CY-dy,SR,"fb2nosound.mdl")call SetUnitVertexColor(M[vN],HV[Ni*4+1],HV[Ni*4+2],HV[Ni*4+3],$FF)endifset Ev[vN]=Ncset fv[vN*3+1]=trueset fv[vN*3+2]=trueset fv[vN*3+3]=trueset Xv[vN]=bcset cv[vN]=Ei[Ni]set dv[vN]=25set qv[vN]=giset Mv[vN]=hiset mv[vN]=Hicall TR(vN,$3E8*.03,TX-dx,TY-dy)set dx=U[bi]-GetUnitX(M[cc])set dy=W[bi]-GetUnitY(M[cc])if HV[Ni*4]==0 thenset vN=qR(2,Ni,'e000',CX-dx,CY-dy,SR,"fbnosound.mdl")elseif HV[Ni*4]==-1 thenset vN=qR(2,Ni,'e000',CX-dx,CY-dy,SR,"fb2nosound.mdl")call SetUnitVertexColor(M[vN],HV[Ni*4+1],HV[Ni*4+2],HV[Ni*4+3],$FF)endifset Ev[vN]=Ncset fv[vN*3+1]=trueset fv[vN*3+2]=trueset fv[v