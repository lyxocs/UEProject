n Jc takes nothing returns nothingcall DestroyLightning(Ae)endfunctionfunction kc takes integer Kc,real w,real x,real y,real dx,real dy,real Nc,real IO,string lc returns nothinglocal integer cO=Qvlocal integer Lc=0local lightning mclocal real URlocal real Mc=Nclocal real pxlocal real pylocal real alocal real btlocal real Dlocal real pclocal real Pclocal real qclocal real Qclocal boolean sc=falselocal boolean xb=truelocal integer Sc=bv[Kc]local integer NA=gV[Sc]if dx==0 thenset a=$98967Felseset a=dy/ dxendifloopexitwhen cO==0if(gV[bv[cO]]!=NA or Mv[cO]==di or Mv[cO]==za or(Jv[cO]or Kv[cO]))and fv[3*cO+2]and not(Mv[cO]==Fa)thenset px=U[cO]-xset py=W[cO]-yset UR=px*(-dy)+py*dxif((Wr[cO]!=0)and(UR>-'x')and(UR<'x')and(px*dx+py*dy>0))thenset pc=U[cO]-xset Pc=W[cO]-yif(pc*pc+Pc*Pc>$3840)thenset bt=-a*(x-U[cO])+y-W[cO]set D=SquareRoot(a*a*$3840-bt*bt+$3840)set pc=(D-a*bt)/(a*a+1)set Pc=-(D+a*bt)/(a*a+1)set qc=a*pc+bt+W[cO]set Qc=a*Pc+bt+W[cO]set pc=pc+U[cO]set Pc=Pc+U[cO]set px=(x-pc)set py=(y-qc)set UR=px*px+py*pyset px=(x-Pc)set py=(y-Qc)set D=px*px+py*pyif D<UR thenset pc=Pcset qc=Qcset UR=Dendifif UR<Mc*Mc thenset Mc=SquareRoot(UR)set sc=trueset Lc=cOendifelsecall DestroyEffect(AddSpecialEffect("Thunderclap_nosplat.mdl",x,y))returnendifelseif UR>-w and UR<w thenset UR=px*dx+py*dyif UR>0 and(UR-dv[cO])<Mc thenif not(Mv[cO]==di and gV[bv[cO]]==NA and bv[Kc]!=bv[cO])thenset Lc=cOset Mc=UR-dv[cO]set sc=falseendifendifendifendifset cO=Rv[cO]endloopif sc thenset Pc=(U[Lc]-pc)/ 'x'set Qc=(W[Lc]-qc)/ 'x'set D=2*(Pc*dx+Qc*dy)set px=(dx-Pc*D)set py=(dy-Qc*D)call KillUnit(CreateUnit(Player($C),'shld',pc,qc,bj_RADTODEG*Atan2(-Qc,-Pc)))set mc=AddLightning(lc,true,x,y,pc,qc)set ie[((OI((function Jc),((.3)*1.),(0),(0),(0),0,0,0)))]=(mc)set mc=nullset D=(Nc-Mc)if D>'d' and IO>2.1 thenset Pc=(D*px+pc)set Qc=(D*py+qc)call kc(Lc,w,pc,qc,px,py,D,IO-1.,lc)elsecall DestroyEffect(AddSpecialEffect("Ab