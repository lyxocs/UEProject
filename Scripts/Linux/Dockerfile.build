FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl libicu74 libssl3t64 zlib1g build-essential python3 git \
    && rm -rf /var/lib/apt/lists/*
# Engine and project are mounted at build time; never baked into this image.
